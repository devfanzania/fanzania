<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <add key="loggerConfigurationFile" value="log4net.config"/>
    <add key="EnvCode" value="PRODUCTION"/>
    <add key="AppName" value="FantasyCricketScoreIntegration"/>
    <add key="APIBaseUrl" value="https://api.sports.roanuz.com/v5"/>
    <add key="project_key" value="RS_P_1422019789852905576"/>
    <add key="APIKey" value="RS5:c4f69849763ad002c85edaec5dd69dff"/>
    <add key="ScoreTimerInterval" value="180000"/>
    <add key="PointCalcTimerInterval" value="400000"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="WeatherAPIUrl" value="https://api.openweathermap.org/data/2.5/weather?q="/>
    <add key="WeatherAPIKey" value="7d26e9df8d4262057f3b6d1ff27d39d4"/>
    <add key="UpdatePlyaerStatTimerInterval" value="1600000"/>
  </appSettings>
  <connectionStrings>
    <add name="FANTASYCRICKET" connectionString="Data Source=fanzania.database.windows.net;Initial Catalog=FANTASYCRICKET;User Id=fcricketuser;Password=Fanzaniacri!cket;Application Name='FantasyCricketScoreIntegration';"/>
  </connectionStrings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
  <log4net>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="LogFileAppender"/>
      <appender-ref ref="AdoNetAppender4Audit"/>
      <appender-ref ref="AdoNetAppender4Exception"/>
    </root>
    <logger name="Common.Logger.CommonLogger" additivity="false">
      <appender-ref ref="LogFileAppender"/>
      <appender-ref ref="AdoNetAppender4Audit"/>
    </logger>
    <logger name="ExceptionLogger" additivity="false">
      <appender-ref ref="AdoNetAppender4Exception"/>
    </logger>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <!--bufferSize value="1" /-->
      <param name="File" value="C:\FantasyLogs\FantasyCricket.ScoreIntegration.txt"/>
      <param name="AppendToFile" value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="10"/>
      <maximumFileSize value="2MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%date [%thread] %-5level %logger - %message%newline"/>
      </layout>
    </appender>
    <appender name="AdoNetAppender4Audit" type="log4net.Appender.AdoNetAppender">
      <bufferSize value="1"/>
      <connectionType value="System.Data.SqlClient.SqlConnection, System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
      <connectionString value="Data Source=fanzania.database.windows.net;initial catalog=FANTASYCRICKET;User ID=fcricketuser;Password=Fanzaniacri!cket" providerName="System.Data.SqlClient"/>
      <commandText value="InsertAudit"/>
      <commandType value="StoredProcedure"/>
      
      <parameter>
        <parameterName value="@envCode"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="envCode"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@productName"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="productName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@apiName"/>
        <dbType value="String"/>
        <size value="500"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="apiName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@fileName"/>
        <dbType value="String"/>
        <size value="256"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="fileName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@loginUser"/>
        <dbType value="String"/>
        <size value="200"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="loginUser"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@hostName"/>
        <dbType value="String"/>
        <size value="100"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="hostName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@transactionId"/>
        <dbType value="String"/>
        <size value="100"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="transactionId"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@transactionType"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="transactionType"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@status"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="status"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@message"/>
        <dbType value="String"/>
        <size value="200"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="message"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@payload"/>
        <dbType value="String"/>
        <size value="-1"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="payload"/>
        </layout>
      </parameter>
    </appender>
    <appender name="AdoNetAppender4Exception" type="log4net.Appender.AdoNetAppender">
      <bufferSize value="1"/>
      <connectionType value="System.Data.SqlClient.SqlConnection, System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
      <connectionString value="Data Source=fanzania.database.windows.net;initial catalog=FANTASYCRICKET;User ID=fcricketuser;Password=Fanzaniacri!cket;" providerName="System.Data.SqlClient"/>
      <commandText value="InsertException"/>
      <commandType value="StoredProcedure"/>
      <parameter>
        <parameterName value="@envCode"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="envCode"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@productName"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="productName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@apiName"/>
        <dbType value="String"/>
        <size value="500"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="apiName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@fileName"/>
        <dbType value="String"/>
        <size value="256"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="fileName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@loginUser"/>
        <dbType value="String"/>
        <size value="200"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="loginUser"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@hostName"/>
        <dbType value="String"/>
        <size value="100"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="hostName"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@transactionId"/>
        <dbType value="String"/>
        <size value="100"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="transactionId"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@transactionType"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="transactionType"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@errorCode"/>
        <dbType value="String"/>
        <size value="50"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="errorCode"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@errorMessage"/>
        <dbType value="String"/>
        <size value="500"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="errorMessage"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@stackTrace"/>
        <dbType value="String"/>
        <size value="-1"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="stackTrace"/>
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@payload"/>
        <dbType value="String"/>
        <size value="-1"/>
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="payload"/>
        </layout>
      </parameter>
    </appender>
  </log4net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
