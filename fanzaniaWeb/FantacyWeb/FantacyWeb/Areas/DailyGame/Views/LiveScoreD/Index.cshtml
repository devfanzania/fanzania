                                                        SR
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody id="score_batsman_inng2"></tbody>
                                        </table>
                                        <hr />
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th class="th-desc">
                                                        BOWLER
