                                                        ER
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody id="score_bowler_inng2"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="blankMsg" class="inner-wrap" styly="display:none;">
    <div class="container">
        <div class="dashboard">
            <div class="dashboard-in">
                <div class="row">
                    <div class="col-md-12 text-center">
                        <h4 class="text-center">
                            <strong>
                                Stay tuned. We will be back with live scoring once your next match starts or check your subscription package.
                            </strong>
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<input type="hidden" id="hdnTourCnt" />

@Html.Hidden("MatchId")
@Html.Hidden("TournamemtId")
@Html.Hidden("Team1")
@Html.Hidden("Team2")
@Html.Hidden("UserTeamId")
