							<tr><td>75 runs</td><td class="text-center">35</td><td class="text-center">30</td><td class="text-center">20</td></tr>
                            <tr><td>Century</td><td class="text-center">50</td><td class="text-center">40</td><td class="text-center">30</td></tr>
                            <tr><td>Maiden Over</td><td class="text-center">20</td><td class="text-center">10</td><td class="text-center">2</td></tr>
							<tr><td>Each Dot Ball Bowled</td><td class="text-center">2</td><td class="text-center">0</td><td class="text-center">0</td></tr>
