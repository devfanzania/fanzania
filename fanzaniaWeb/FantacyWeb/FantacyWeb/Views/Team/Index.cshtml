
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}
<input type="hidden" id="hdnTourCnt" />
<input type="hidden" id="hdnMatchCnt" />
@Html.Hidden("TournamentStatus")
@Html.Hidden("UserteamId")
@Html.Hidden("TournamentName")
 
    <style>
        .border {
            border: 1px solid #0c0c0b;
            font-size: 11px;
            padding-top: 24px;
        }

        .title {
            color: #fa3f45;
            font-size: 15px;
            font-weight: 700;
        }

        .rowpadding {
            padding-bottom: 17px;
            padding-top: 40px;
        }

        .powerplay {
            color: #000 !important;
            padding-top: 22px !important;
            padding-bottom: 36px;
            height: 90px;
            margin: 10px;
        }

        .btn4 {
            border: 1px solid #1d920e;
            padding: 10px 10px 10px 10px;
            position: relative;
            float: right;
            border-radius: 30px;
            color: #000;
            margin: 20px 0px 20px 0;
            font-weight: 600;
            font-size: 11px;
            width: 100%;
        }

        .btncu {
            /* border: 1px solid #1d920e; */
            padding: 10px 10px 10px 10px;
            position: relative;
            float: right;
            border-radius: 30px;
            color: #fff;
            margin: 20px 0px 20px 0;
            font-weight: 600;
            font-size: 11px;
            width: 100%;
            background-color: #e23535;
        }

        .btn-proceedtopayment {
            background: linear-gradient(to left, #fa3f45 0%,#ff9000 100%);
            color: #fff;
            font-weight: 500;
            width: 100%;
            padding: 10px 50px;
            position: relative;
            margin-left: 10px;
            border-radius: 30px;
        }

        .powerplayimage {
            position: absolute;
            z-index: 999;
            right: 195px;
            top: 15px;
            opacity: 1;
        }

        .usedbtn {
            border: 1px solid #000;
            padding: 10px 10px 10px 10px;
            position: relative;
            float: right;
            border-radius: 30px;
            color: #000;
            margin: 20px 0px 20px 0;
            font-weight: 600;
            font-size: 11px;
            width: 100%;
            background-color: #80808026;
        }
    </style>
    <section id="TournamentSlider" class="inner-wrap">
        <div class="container">
            <div class="banner-slider">
                <div class="row">
                    <div class="col-md-12">

                        <div class="carousel slide multi-item-carousel" data-interval="false" data-wrap="false" id="theCarousel">
                            <div id="UserTournamentBox" class="carousel-inner">

                            </div>
                        </div>
                        <a id="TournamentSlide_prev" class="left carousel-control" href="#theCarousel" data-slide="prev" onclick="OnChangeTournamentSlide('prev');"><i class="fa fa-angle-left"></i></a>
                        <a id="TournamentSlide_next" class="right carousel-control" href="#theCarousel" data-slide="next" onclick="OnChangeTournamentSlide('next');"><i class="fa fa-angle-right"></i></a>
                    </div>

                </div>
            </div>
        </div>

    </section>
    <section>
        <div class="container">
            <div class="row">

                <div class="">
                    <div class="col-md-12">
                        <div class="carousel slide" data-interval="false" data-wrap="false" id="CarouselMatch">
                            <div id="MatchDetails" class="carousel-inner">

                            </div>
                            <a id="CarouselMatch_left" style="height: 41px !important;" class="left carousel-control" href="#CarouselMatch" data-slide="prev"><i class="fa fa-angle-left"></i></a>
                            <a id="CarouselMatch_right" style="height: 37px !important;" class="right carousel-control" href="#CarouselMatch" data-slide="next"><i class="fa fa-angle-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="container">
            <div class="team-heading">
                <div class="row">
                    <div class="col-md-12">
                        <img src="/Assets/Icon/fanzania-icon-white.png" />
                        <p id="teamname"></p>
                        <a title="Change team name" class="changename" onclick="openTeamNameChangeModal()" ;><i class="fa fa-pencil"></i></a>
                        <div class="pull-right">
                            <div class="mat-d">

                                <h5 id="teampoint"></h5>
                                <p style="padding: 0px 2px 0 5px !important;"  id="Tp_heading"></pstyle="padding:>
                            </div>

                            <div class="mat-d">
                                <h5 id="powerplay"></h5>
                               
                                <p style="padding: 0px 2px 0 5px !important;">PowerPlay</p>
                            </div>
                            <div class="mat-d">
                                <h5 id="winnerPredictionteam"></h5>
                                <p id="" style="padding: 0px 2px 0 5px !important;">Winner Prediction</p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
    <section>
        <div class="dashboard2">
            <div class="container">
                <div class="row">
                    <div class="d-ground">
                        <div class="pull-left">
                            <div id="teamstat"></div>
                            </div>
                            <div class="pull-right">
                                <div id="manageTeam"></div>
                                <br />
                                <div id="powerplaybutton"></div>

                                <br />

                                
                            </div>
                            <div class="playground-team">
                                <div class="Players">
                                    <div id="Players">
                                    </div>
                                </div>
                                <div class="team-indicate">
                                    <img src="~/Assets/Icon/WicketkeeperGrey.png" />
                                </div>
                                <div class="team-indicate2">
                                    <img src="~/Assets/Icon/BatsmanGrey.png" />

                                </div>
                                <div class="team-indicate3">
                                    <img src="~/Assets/Icon/BowlerGrey.png" />
                                </div>
                                <div class="team-indicate4">
                                    <img src="~/Assets/Icon/AllrounderGrey.png" />
                                </div>
                            </div>
                        </div>
                    </div>
            </div>

        </div>
    </section>

    <div id="ModalChangeName" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content modal-bak">
                <div class="modal-header">
                    <span>
                        <img src="~/Assets/Icon/fanzania-icon.png" class="modal-logo" />
                        <h4 class="modal-title text-center">Change team name</h4>
                    </span>

                </div>
                <div class="modal-body" style="padding-left: 10px;">

                    <table class="table" style="width: 100%;">
                        <tbody>
                            <tr>
                                <td colspan="2">
                                    <input type="text" id="txtTeamNewName" class="form-control" placeholder="Enter new name" maxlength="10" />
                                    <span class="Labelregister">Team name minimum 3 characters</span>
                                </td>
                                <td colspan="2">
                                    <div id="checkmsg" class="text-center"></div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-width-80" onclick="CheckNameAvailable();">Confirm</button>
                    <button type="button" class="btn btn-primary btn-width-80" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade league-modal" id="power-play-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLongTitle" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <img src="/Assets/Image/fanzania-icon-o.png">
                    <h5 class="modal-title" id="exampleModalLongTitle" style="padding-right: 60px;"><span id="Modal_Teamname">POWERPLAY LIFELINE    </h5>
                    <img src="/Assets/Icon/Powerplay_Lifeline.png" class="powerplayimage" alt="" height="20px" width="20px">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true"><img src="/Assets/Image/close.png"></span>
                    </button>
                </div>
                <div class="modal-body" style="max-height: 600px !important;">
                    <input type="hidden" id="NitroUserTeamMatchPointId" value="">
                    <input type="hidden" id="PainKillerUserTeamMatchPointId" value="">
                    <input type="hidden" id="AutoPilotUserTeamMatchPointId" value="">
                    <input type="hidden" id="NitroPoints" value="">
                    <input type="hidden" id="PainKillerPoints" value="">
                    <input type="hidden" id="AutoPilotPoints" value="">
                    <input type="hidden" id="NitroEnable" value="false">
                    <input type="hidden" id="PainKillerEnable" value="false">
                    <input type="hidden" id="AutoPilotEnable" value="false">

                    <div class="row" style="margin-right: 0px!important; margin-left: 0px !important;">
                        <div class="col-md-12 modal-tab">
                            <div class="">
                                <div id="livematch" class="tab-pane fade in active">
                                    <div class="row">
                                        <div class="col-md-12 text-center">
                                            <div class="" style="color: #fa3f45;font-size: 13px;" id="content">
                                                Lifeline gives you the option to replay your PowerPlays one additional time. 
                                                Upon saving, any previously scored  bonus points will be nullified when this option is used.
                                            </div>
                                        </div>

                                    </div>
                                    <div class="row rowpadding">

                                        <div class=" col-md-4 text-center">

                                            <img class="ppImg" src="/Assets/Icon/nitro.png" style="height:25px;width:25px" />
                                        </div>
                                        <div class=" col-md-4 text-center">
                                            <img class="ppImg" src="/Assets/Icon/Painkiller.png" style="height:25px;width: 25px" />
                                        </div>
                                        <div class=" col-md-4 text-center">
                                            <img class="ppImg" src="/Assets/Icon/Autocaptain.png" style="height:25px;width: 25px" />
                                        </div>

                                    </div>
                                    <div class="row">

                                        <div class=" col-md-4 text-center ">

                                            <div class="border">
                                                <span class="title">NITRO</span>
                                                <p class="powerplay" id="availablenitro">Lifeline available. You scored <span style="font-weight: 700;" id="NitroPointsshow"> </span>from your first use.</p>
                                                <p class="powerplay" id="notavailablenitro">Lifeline is not available as you have not used the first attempt.</p>
                                                <p class="powerplay" id="usednitro">Lifeline option already used.</p>
                                            </div>
                                        </div>
                                        <div class=" col-md-4 text-center ">
                                            <div class="border">
                                                <span class="title">PAINKILLER</span>
                                                <p class="powerplay" id="availablepk">Lifeline available. You scored <span style="font-weight: 700;" id="PainKillerPointsshow"> </span>from your first use.</p>
                                                <p class="powerplay" id="notavailablepain">Lifeline is not available as you have not used the first attempt.</p>
                                                <p class="powerplay" id="usedpain">Lifeline option already used.</p>
                                            </div>

                                        </div>
                                        <div class=" col-md-4 text-center  ">
                                            <div class="border">
                                                <span class="title">ULTRACAPTAIN</span>
                                                <p class="powerplay" id="availableuc">Lifeline available. You scored <span style="font-weight: 700;" id="AutoPilotPointsshow"> </span>from your first use.</p>
                                                <p class="powerplay" id="notavailableultra">Lifeline is not available as you have not used the first attempt.</p>
                                                <p class="powerplay" id="usedultra">Lifeline option already used.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class=" col-md-4 text-center">
                                            <button  disabled id="btnusednitro" style="display:none;" class="usedbtn">Used</button>
                                            <button disabled id="cubtnnitro" style="display:none;" class="btncu">Currently Unavailable</button>
                                            <a href="#" id="tabtoselectbtnnitro" class="btn4 TabToSelectNitro" onclick="TabToSelectNitro('true')" ;>Tap To Select</a>
                                            <a href="#" style="background-color:#18cc00b5;display:none;" class="btn4 TabToSelectNitroselected" onclick="TabToUnSelectNitro('false')" ;><i class="fa fa-check" style="color:#fff !important;margin-right: 5px;" aria-hidden="true"></i>Selected</a>
                                        </div>
                                        <div class=" col-md-4 text-center">
                                            <button  disabled id="usedpk" style="display:none;" class="usedbtn">Used</button>
                                            <button disabled id="cubtnpk" class="btncu">Currently Unavailable</button>
                                            <a href="#" id="tabtoselectbtnpc" class="btn4 TabToSelectPain" onclick="TabToSelectPain('true')" ;>Tap To Select</a>
                                            <a href="#" style="background-color:#18cc00b5;display:none;" class="btn4 TabToSelectPainselected" onclick="TabToUnSelectPain('false')" ;><i class="fa fa-check" style="color:#fff !important;margin-right: 5px;" aria-hidden="true"></i>Selected</a>
                                        </div>
                                        <div class=" col-md-4 text-center">
                                            <button disabled  id="usedcu" style="display:none;" class="usedbtn">Used</button>
                                            <button disabled  id="cubtncu" class="btncu">Currently Unavailable</button>
                                            <a href="#" id="tabtoselectbtnuc" class="btn4 TabToSelectUltra" onclick="TabToSelectUltra('true')" ;>Tap To Select</a>
                                            <a href="#" style="background-color:#18cc00b5;display:none;" class="btn4 TabToSelectUltraselected" onclick="TabToUnSelectUltra('false')" ;><i class="fa fa-check" style="color:#fff !important;margin-right: 5px;" aria-hidden="true"></i>Selected</a>
                                        </div>

                                    </div>

                                    <div class="row notselectmessage">
                                        <div class=" col-md-12 text-center">
                                            <span style="color: #fa3f45;font-size: 12px;">You have not selected any PowerPlay Lifeline to save</span>
                                        </div>
                                    </div>
                                    <div class="row tabtoselectmessage" style="display:none" >
                                        <div class=" col-md-12 text-center" style="padding-top: 15px; padding-bottom: 15px;">
                                            <span style="color: #fa3f45;font-size: 12px; font-weight:600;">IMPORTANT</span><br />

                                        </div>
                                    </div>
                                    <div class="row tabtoselectmessage"  style="display:none">
                                        <div class=" col-md-12 text-center">
                                            <span style="color: #fa3f45;font-size: 12px;">Previously scored bonus points will be nullified upon saving and cannot be reverted </span>
                                        </div>
                                    </div>

                                    <div class="row tabtoselectmessage"  style="display:none">
                                        <div class=" col-md-12 text-center" style="padding-top: 15px; padding-bottom: 15px;">
                                            <span style="font-size: 12px;">Your selected PowerPlays will be available for reuse in the ‘Team Manager’ screen. You can choose to reuse anytime over the course of the tournament and the same rules as with the original PowerPlays will apply.  </span>
                                        </div>
                                    </div>

                                    <div class="row" style="padding-top: 18px;">

                                        <div class="hedingtitleLs"><a  href="#" id="savebtn" class="btn-proceedtopayment "   onclick="UpdatePowerPlay()" ;  style="display:none">SAVE</a> </div>
                                        <div class=" col-md-12 text-center">
                                            <button type="button" id="disablebtn" disabled style="border-radius: 20px; width: 138px; height: 35px; color: #000;background-color: #eadfdf; border: 2px solid #eadfdf; " class="breakdown widrow">SAVE</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                </div>

            </div>
        </div>
    </div>
    <div id="modelweathericon" class="modal fade">
        <div class="modal-dialog modal-med" style="width: 420px !important;">
            <div class="modal-content">
                <div class="modal-header" >
                    <img src="/Assets/Image/fanzania-icon-o.png" style="max-width: 50px;float: left;">
                    <h5 class="modal-title" style="color: #fa3f45;text-align: center;font-size: 16px;font-weight: 600;margin-right: 30px;">Live Weather</h5>
                    <p style="color: #fa3f45;text-align: center;font-size: 12px;margin-right: 30px;">3 pm IST | 20 sep 2021</p>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="position: absolute; z-index: 999;right: 20px;top: 5px;opacity: 1;margin-top: 10px;">
                        <span aria-hidden="true"><img src="/Assets/Image/close.png" style="width: 25px;"></span>
                    </button>
                </div>
                <div class="modal-body" style="padding-left: 10px;">
                    <p style="font-size: 20px;">Bengaluru</p>
                    <p style="font-size: 16px;">India</p>
                    <img src="/Assets/Icon/sunny.png" alt="" style="width: 84px;text-align: center;">
                    <p style="padding-bottom: 14px;"> Sunny</p>
                    <p style="font-size: 18px;">27 C</p>
                </div>
                

            </div>
        </div>
    </div>
    <div id="spinnerContainer" class="spinnerContainer" style="display: block;">
        <div id="spinner" class="spinner">
            <img id="img-spinner" src="~/Assets/Icon/ball.gif" alt="Loading" />
        </div>
    </div>
    <script>
    $(document).ready(function () {
        Session_usedId = '@Session["UserId"].ToString()';
       // alert(Session_usedId);
    });
    var Session_usedId = '';
    </script>
    <script src="~/CustomScript/Team/TeamView.js"></script>



