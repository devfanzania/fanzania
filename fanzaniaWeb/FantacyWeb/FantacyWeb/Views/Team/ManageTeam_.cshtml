                    //}
                    //else {
                    $row.find('.Action').append('<a href="#" title="Add" onclick="return SelectOrRemove(\'' + record.PlayerId + '\',\'A\',\'' + record.PlayerSpeciality + '\',\'' + record.PlayerValue + '\',\'' + record.TeamDescription + '\',\'' + record.PlayerType + '\');" ><img src="/Assets/Icon/plus.png" alt="" height="18px" width="18px"/></a>');
