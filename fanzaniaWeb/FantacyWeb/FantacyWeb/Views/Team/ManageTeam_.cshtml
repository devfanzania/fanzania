            function CheckLastCutOff() {
                debugger;
                var uurl ='/Team/TeamPlayer_LastCutoff';

                $.ajax({
                    url: uurl,
                    type: 'POST',
                    //data: jsonData,
                    dataType: 'json',
                    async: true,
                    cache: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (data) {

                        if(data == 0){
                            $("#anc_autofill").removeAttr("disabled");
                            $('#anc_reset').attr("disabled","disabled");
                        }
                        else {
                            $("#anc_reset").removeAttr("disabled");
                            $('#anc_autofill').attr("disabled","disabled");
                        }
                    },
                    error: function (req, status, error) {
                        alert('Unable to connect server for Team Rules 5!');
                        return false;
                    }
                });
            }

            function LoadTeamSelectionRules() {
                debugger;
                var uurl ='/Team/PlayerSelectionRules';
                var Tid = @Session["SelectTournamentId"].ToString();
                var pData = { TournamentId: Tid };
                var jsonData = JSON.stringify(pData);
                $.ajax({
                    url: uurl,
                    type: 'POST',
                    data: jsonData,
                    dataType: 'json',
                    async: true,
                    cache: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (data) {

                        $.each(data, function (index, value) {

                            $('#Rule_WicketKeeper').val(value.WicketKeeper);
                            $('#Rule_MaxBatsman').val(value.MaxBatsman);
                            $('#Rule_MinBatsman').val(value.MinBatsman);
                            $('#Rule_MaxBowler').val(value.MaxBowler);
                            $('#Rule_MinBowler').val(value.MinBowler);
                            $('#Rule_MaxAllrounder').val(value.MaxAllrounder);
                            $('#Rule_MinAllrounder').val(value.MinAllrounder);
                            //AllotedBudget = value.TotalBudget;
                            // $('#AllotedBudget').html(value.TotalBudget + 'K');
                            debugger;
                            $('#AllotedBudget').val(value.TotalBudget);
                            $('#Rule_MaxSameTeamPlayer').val(value.MaxSameTeamPlayer);
                            $('#Rule_MaxOverseasPlayer').val(value.MaxOverseasPlayer);

                            $('#SubsCount').html('/' + value.SubCount);
                            $('#Rule_SubCount').val(value.SubCount);
                        });

                    },
                    error: function (req, status, error) {
                        alert('Unable to connect server for Team Rules 4!');
                        return false;
                    }
                });
            }
