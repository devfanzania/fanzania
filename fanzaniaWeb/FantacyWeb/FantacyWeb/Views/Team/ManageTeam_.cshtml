@Html.Hidden("PainKillerUsed")

@Html.Hidden("AllotedBudget")
@Html.Hidden("Budget_Calc")
@Html.Hidden("Transfer_Cnt")
@Html.Hidden("Tournament_Status")

<div class="container body-container">

    <div class="row">
        <div class="col-md-6 text-left"><a href="/Team/Index" class="back-team-btn"><i class="fa fa-arrow-left"></i>  Back to Team</a></div>
    </div>
    <div class="row"><div class="dashboard-title2 text-center"><h5>@ViewBag.TournamentName</h5><h5>@ViewBag.TeamName</h5></div></div>
    <div class="row">
        <div class="col-md-4">
            <div class="info-box-2">
                <div class="info-box-content-2">
                    <span class="info-box-text-2 bgt-icn">
                        <img src="~/Assets/Icon/money.png" />
                    </span>
                    <span class="info-box-text-2">Budget </span>
                    <span class="info-box-number"><span id="TotalBudget"></span>@*<span id="AllotedBudget"></span>*@</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box-2">
                <div class="info-box-content-2 filterCursor" onclick="OpenTeamFilterModal();">
                    <span id="filter_team" class="info-box-text-2">Filter By Team </span>
                    <span class="info-box-text-2 bgt-icn"><i class="fa fa-filter"></i></span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box-2">
                <div class="info-box-content-2">
                    <span class="info-box-text-2 bgt-icn">
                        <img src="~/Assets/Icon/transfer.png" />
                    </span>
                    <span class="info-box-text-2">Transfer </span>
                    <span class="info-box-number"><span id="SubsLeft">@Model.Transfer_left</span><span id="SubsCount"></span></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row text-center">
        <div id="playerlistcontainer" class="col-md-6">
            <div id="PLayerList" class="row">

                <div class="col-md-12">
                    <div class="row">

                        <ul class="f-btn">
                            <li><button id="btn_AllP" type="button" onclick="FilterByType('All');">All</button></li>
                            <li>
                                <button id="btn_Bat" type="button" onclick="FilterByType('batsman');">
                                    <img src="~/Assets/Icon/bat.png" />
                                </button>
                            </li>
                            <li>
                                <button id="btn_Wk" type="button" onclick="FilterByType('wicketkeeper');">
                                    <img src="~/Assets/Icon/gloves.png" />
                                </button>
                            </li>
                            <li>
                                <button id="btn_AllR" type="button" onclick="FilterByType('allrounder');">
                                    <img src="~/Assets/Icon/batball.png" />
                                </button>
                            </li>
                            <li>
                                <button id="btn_Bwl" type="button" onclick="FilterByType('bowler');">
                                    <img src="~/Assets/Icon/ball.png" />
                                </button>
                            </li>

                        </ul>
                    </div>
                    <div class="row">
                        <div class="searchbox">
                            <input type="text" id="SearchPlayer" class="searcharea" placeholder="Type the player name and press enter" />
                            <span class="search-button"><i class="fa fa-search"></i></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="playergrid">
                            <table id="playergrid"></table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-md-6">
            <div class="row ag">
                <div class="col-md-4">
                    <p>NITRO</p>
                    <label class="switch">
                        <input type="checkbox" id="Chk_Booster" onclick="BoosterChange('Chk_Booster')" ;>

                        <span class="switchslider round"></span>
                    </label>
                </div>
                <div class="col-md-4">
                    <p>PAIN KILLER</p>
                    <label class="switch">
                        <input type="checkbox" id="Chk_PainKiller" onclick="BoosterChange('Chk_PainKiller')" ; />
                        <span class="switchslider round"></span>
                    </label>
                </div>
                <div class="col-md-4">
                    <p>AUTO CAPTAIN</p>
                    <label class="switch">
                        <input type="checkbox" id="Chk_AutoCaptain" onclick="BoosterChange('Chk_AutoCaptain')" ; />
                        <span class="switchslider round"></span>
                    </label>
                </div>
            </div>
            <div class="playground">

                <div class="center-play">
                    <div id="playerList" style="padding-top:45px; ">
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-4">
                    <a id="anc_autofill" href="#" class="btn theme-btn-dash" onclick="Autofill()" ;>Autofill</a>
                </div>
                <div class="col-md-4">
                    <a id="anc_reset" href="#" class="btn theme-btn-dash" onclick="LoadSelectedPlayers_LastCutoff()" ;>Reset</a>
                </div>
                <div class="col-md-4">
                    <a href="#" class="btn theme-btn-dash" onclick="SavePlayers()" ;>Save</a>
                </div>
            </div>
            <div id="div_bottom"></div>
        </div>

        <div id="ModalCapVCap" class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content modal-bak">
                    <div class="modal-header">
                        <span>
                            <img src="~/Assets/Icon/fanzania-icon.png" class="modal-logo" />
                            <h4 class="modal-title"><span id="Modal_Playername"></span></h4>
                        </span>
                        <img src="~/Assets/Icon/close_popup.png" alt="" class="close  img-popup" data-dismiss="modal" aria-hidden="true" />
                    </div>
                    <div class="modal-body">

                        <div class="capt">
                            <table>
                                <tr>
                                    <td>
                                        <input type="checkbox" id="Chk_captain" class="radio" value="1" name="capvs[1][]" /><p class="c-tp">Select as Captain</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <input type="checkbox" id="Chk_vcaptain" class="radio" value="1" name="capvs[1][]" /><p class="c-tp">Select as Vice Captain</p>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        @Html.Hidden("PlayerId_CapVs")
                       
                        <button type="button" class="btn btn-primary btn-width-80" onclick="SaveCaptainVsCaptain();">Done</button>
                        @*<button type="button" class="btn btn-primary btn-width-80" data-dismiss="modal">Close</button>*@
                    </div>
                </div>
            </div>
        </div>

        <div id="ModalTeamFilter" class="modal fade">
            <div class="modal-dialog">
                <div class="modal-content modal-bak">
                    <div class="modal-header">
                        <span>
                            <img src="~/Assets/Icon/fanzania-icon.png" class="modal-logo" />
                            <h4 class="modal-title"><span>Sort by team name</span></h4>
                        </span>
                        <img src="~/Assets/Icon/close_popup.png" alt="" class="close  img-popup" data-dismiss="modal" aria-hidden="true" />
                    </div>
                    <div class="modal-body">
                        <div class="capt2">
                            <select id="ddlTeamlist" class="ddlTeamlist" multiple="multiple" placeholder="Select Team"></select>
                        </div>
                    </div>
                    <div class="modal-footer">

                        <button type="button" class="btn btn-primary btn-width-80" onclick="FilterTeam();">Done</button>
                        <button type="button" class="btn btn-primary btn-width-80" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            $("input:checkbox").on('click', function() {
                // in the handler, 'this' refers to the box clicked on
                var $box = $(this);
                if ($box.is(":checked")) {
                    // the name of the box is retrieved using the .attr() method
                    // as it is assumed and expected to be immutable
                    var group = "input:checkbox[name='" + $box.attr("name") + "']";
                    // the checked state of the group/box on the other hand will change
                    // and the current value is retrieved using .prop() method
                    $(group).prop("checked", false);
                    $box.prop("checked", true);
                } else {
                    $box.prop("checked", false);
                }
            });
            $(document).ready(function () {
                debugger;
                var Tid = @Session["SelectTournamentId"].ToString();
                LoadTeamSelectionRules();
                CheckLastCutOff();
                LoadSelectedPlayers();
                ShowPlayerList();

                $('#SelectedPlayerCnt').val(@Session["SelectPlayerCount"].ToString());
                $('#SelectedBat').val(@Session["BatsmanCount"].ToString());
                $('#Selectedwk').val(@Session["WicketkeeperCount"].ToString());
                $('#SelectedBowl').val(@Session["BowlerCount"].ToString());
                $('#SelectedAll').val(@Session["AllrounderCount"].ToString());
                //debugger;

                $('#div_bottom').focus();
                $('#SubsLeft').html(@Session["Subs"].ToString());
                $('#anc_autofill').attr("disabled","disabled");
                $('#anc_reset').attr("disabled","disabled");
                $('#NitroLeft').val(@Session["NitroLeft"].ToString());
                $('#AutoPilotLeft').val(@Session["AutoPilotLeft"].ToString());
                $('#PainKillerLeft').val(@Session["PainKillerLeft"].ToString());

                $('#NitroUsed').val('@Session["NitroUsed"].ToString()');
                $('#AutoPilotUsed').val('@Session["AutoPilotUsed"].ToString()');
                $('#PainKillerUsed').val('@Session["PainKillerUsed"].ToString()');

                var nitro =$('#NitroLeft').val();
                var aCap =$('#AutoPilotLeft').val();
                var pk =$('#PainKillerLeft').val();
                var nitroUsed ='@Session["NitroUsed"].ToString()';
                var aCapUsed = '@Session["AutoPilotUsed"].ToString()';
                var pkUsed = '@Session["PainKillerUsed"].ToString()';

                if (nitro == 0){
                    $('#Chk_Booster').attr("disabled","disabled");
                }
                else{
                    $('#Chk_Booster').removeAttr("disabled")
                }

                if(aCap == 0){
                    $('#Chk_AutoCaptain').attr("disabled","disabled");
                }
                else{
                    $('#Chk_AutoCaptain').removeAttr("disabled")
                }

                if(pk == 0){
                    $('#Chk_PainKiller').attr("disabled","disabled");
                }
                else{
                    $('#Chk_PainKiller').removeAttr("disabled")
                }

                if(nitroUsed == 'True'){
                    $('#Chk_Booster').prop( "checked", true );
                    $('#Chk_AutoCaptain').prop( "checked", false );
                    $('#Chk_PainKiller').prop( "checked", false );

                    $('#Chk_AutoCaptain').attr("disabled","disabled");
                    $('#Chk_PainKiller').attr("disabled","disabled");

                }else if(aCapUsed == 'True'){
                    $('#Chk_AutoCaptain').prop( "checked", true );
                    $('#Chk_Booster').prop( "checked", false );
                    $('#Chk_PainKiller').prop( "checked", false );

                    $('#Chk_Booster').attr("disabled","disabled");
                    $('#Chk_PainKiller').attr("disabled","disabled");
                }else if(pkUsed == 'True'){
                    $('#Chk_PainKiller').prop( "checked", true );
                    $('#Chk_AutoCaptain').prop( "checked", false );
                    $('#Chk_Booster').prop( "checked", false );

                    $('#Chk_AutoCaptain').attr("disabled","disabled");
                    $('#Chk_Booster').attr("disabled","disabled");
                }



            });

            var AllotedBudget = 0;
            var Plist = [];
            var Nitro_Cnt = 0;
            var PainKiller_Cnt = 0;
            var AutoPilot_Cnt = 0;
            var TeamDet = new Array();

            function OpenCaptModal(playerid,playerName,playerType){
                $('#PlayerId_CapVs').val(playerid);
                $('#Modal_Playername').html(playerName);

                $('#Chk_captain').prop( "checked", false );
                $('#Chk_vcaptain').prop( "checked", false );

                if(playerType == 'C'){
                    $('#Chk_captain').prop( "checked", true );
                }else if(playerType == 'VC'){
                    $('#Chk_vcaptain').prop( "checked", true );
                }
                $("#ModalCapVCap").modal('show');
            }
            function OpenTeamFilterModal(){
                //$("#ModalTeamFilter").modal('show');
                var uurl ='/Team/ShowTeamFilter';

                $.ajax({
                    url: uurl,
                    type: 'POST',
                    //data: jsonData,
                    dataType: 'json',
                    async: true,
                    cache: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (data) {
                        debugger;
                        if(data.status='Success'){

                            if (data.length > 0) {
                                $('#ddlTeamlist').empty();
                                $.each(data, function (index, value) {
                                    $('#ddlTeamlist').append($("<option Team='" + value.ParticipationTeamId + "'  ></option>").val(value.ParticipationTeamId).html(value.ParticipationTeamName));
                                });

                                $('#ddlTeamlist').multiselect({
                                    columns: 1,
                                    search: true,
                                    texts: {
                                        placeholder: 'Select Team', // text to use in dummy input
                                        search: 'Search'         // search input placeholder text
                                    },
                                    onLoad: function () {
                                        var spn = $('.ms-options-wrap').find('span');
                                        var ln = spn.html().length;
                                        if (ln >= 150) {
                                            var ndata = spn.html().substring(0, 150) + "....";
                                            spn.html(ndata);
                                        }

                                        $('.ms-options-wrap button').on('click', function () {
                                            var w = $('.ms-options-wrap').width() + "px";
                                            $('.ms-options').width(w);
                                        });
                                    }
                                });

                            }

                            $("#ModalTeamFilter").modal('show');
                        }
                    },
                    error: function (req, status, error) {
                        alert('Unable to connect server for Save Captain!');
                        return false;
                    }
                });

            }

            function FilterTeam(){
                var checked_flag = 0;
                var teamname ='';
                $(".ms-options ul li input").each(function () {
                    $this = $(this);
                    if ($this.prop("checked")) {
                        teamname += $('#ddlTeamlist option[value="' + $this.val() + '"]').attr('Team');
                        teamname += ',';
                        checked_flag = 1;
                    }
                });
                if(checked_flag == 1){
                    $('#filter_team').addClass('filter_team');
                }
                else{
                    $('#filter_team').removeClass('filter_team');
                }
                var Tid = @Session["SelectTournamentId"].ToString();

                grid.reload({ page: 1, TournamentId: Tid, FilterTeams: teamname });
                $("#ModalTeamFilter").modal('hide');
                //alert(teamname);
            }

            function SaveCaptainVsCaptain(){
                //debugger;
                var PlayerId = $('#PlayerId_CapVs').val();
                var PlayerSelectas = '';
                if(Chk_captain.checked){
                    PlayerSelectas = 'Captain';
                }
                if(Chk_vcaptain.checked){
                    PlayerSelectas = 'ViceCaptain';
                }
                var uurl ='/Team/SaveCaptainVsCaptain';
                var pData = { PlayerId: PlayerId, PlayerSelectAs: PlayerSelectas};
                var jsonData = JSON.stringify(pData);
                $.ajax({
                    url: uurl,
                    type: 'POST',
                    data: jsonData,
                    dataType: 'json',
                    async: true,
                    cache: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (data) {
                        if(data.status='Success'){
                            $("#ModalCapVCap").modal('hide');

                            $('#Chk_captain').prop( "checked", false );
                            $('#Chk_vcaptain').prop( "checked", false );
                            LoadSelectedPlayers();
                        }
                    },
                    error: function (req, status, error) {
                        alert('Unable to connect server for Save Captain!');
                        return false;
                    }
                });

            }

            function SavePlayers(){
                var NoOfPlayer =  $('#SelectedPlayerCnt').val();
                var NoOf_Wk =  $('#Rule_WicketKeeper').val();
                var NoOf_minBat =  $('#Rule_MinBatsman').val();
                var NoOf_minBwl =  $('#Rule_MinBowler').val();
                var NoOf_minAll =  $('#Rule_MinAllrounder').val();

                var Selectedwk =  $('#Selectedwk').val();
                var SelectedBat =  $('#SelectedBat').val();
                var SelectedBowl =  $('#SelectedBowl').val();
                var SelectedAll =  $('#SelectedAll').val();

                var NitroUsed = $('#NitroUsed').val();
                var AutoPilotUsed = $('#AutoPilotUsed').val();
                var PainKillerUsed = $('#PainKillerUsed').val();
                //debugger;
                if(NoOfPlayer == 11){

                    if(parseInt(NoOf_Wk) != parseInt(Selectedwk)){
                        alert('You have to select atleast one Wicketkeeper');
                    }
                    else{
                        if(parseInt(NoOf_minBat) > parseInt(SelectedBat)){
                            alert('You have to select atleast three Batsman');
                        }
                        else{
                            if(parseInt(NoOf_minBwl) > parseInt(SelectedBowl)){
                                alert('You have to select atleast three Bowler');
                            }
                            else{
                                if(parseInt(NoOf_minAll) > parseInt(SelectedAll)){
                                    alert('You have to select atleast one Allrounder');
                                }
                                else{

                                    var uurl ='/Team/SavePlayer';
                                    var pData = { NitroUsed: NitroUsed, PainKillerUsed: PainKillerUsed , AutoPilotUsed: AutoPilotUsed};
                                    var jsonData = JSON.stringify(pData);
                                    $.ajax({
                                        url: uurl,
                                        type: 'POST',
                                        data: jsonData,
                                        dataType: 'json',
                                        async: true,
                                        cache: false,
                                        contentType: "application/json; charset=utf-8",

                                        success: function (data) {
                                            if(data.status='Success'){
                                                alert('Team Save Successfully');
                                                location.href = '/Team/Index';
                                            }
                                        },
                                        error: function (req, status, error) {
                                            alert('Unable to connect server for Save Team!');
                                            return false;
                                        }
                                    });
                                }
                            }
                        }
                    }
                }
                else {
                    alert('Please select 11 players');
                }
            }

            function BoosterChange(checkType){
                var nitroleft ='@Session["Nitroleft"].ToString()';
                var aCapleft = '@Session["AutoPilotleft"].ToString()';
                var pkleft = '@Session["PainKillerleft"].ToString()';

                if(checkType == 'Chk_Booster'){
                    if (!$('#Chk_Booster').is(':checked')) {
                        $('#NitroUsed').val('False');
                        if(pkleft > 0){
                            $('#Chk_PainKiller').removeAttr("disabled");}
                        if(aCapleft > 0){
                            $('#Chk_AutoCaptain').removeAttr("disabled");}
                    }
                    if (!$('#Chk_Booster').is(':unchecked')) {
                        $('#NitroUsed').val('True');
                        $('#Chk_PainKiller').attr("disabled","disabled");
                        $('#Chk_AutoCaptain').attr("disabled","disabled");
                    }
                }
                if(checkType == 'Chk_PainKiller'){
                    if (!$('#Chk_PainKiller').is(':checked')) {
                        $('#PainKillerUsed').val('False');
                        if(nitroleft > 0){
                            $('#Chk_Booster').removeAttr("disabled");}
                        if(aCapleft > 0){
                            $('#Chk_AutoCaptain').removeAttr("disabled");}
                    }
                    if (!$('#Chk_PainKiller').is(':unchecked')) {
                        $('#PainKillerUsed').val('True');
                        $('#Chk_Booster').attr("disabled","disabled");
                        $('#Chk_AutoCaptain').attr("disabled","disabled");
                    }
                }
                if(checkType == 'Chk_AutoCaptain'){
                    if (!$('#Chk_AutoCaptain').is(':checked')) {
                        $('#AutoPilotUsed').val('False');
                        if(pkleft > 0){
                            $('#Chk_PainKiller').removeAttr("disabled");}
                        if(nitroleft > 0){
                            $('#Chk_Booster').removeAttr("disabled");}
                    }
                    if (!$('#Chk_AutoCaptain').is(':unchecked')) {
                        $('#AutoPilotUsed').val('True');
                        $('#Chk_PainKiller').attr("disabled","disabled");
                        $('#Chk_Booster').attr("disabled","disabled");
                    }
                }

            }


            function MovefromList(pid) {

                alert(pid);
            }

