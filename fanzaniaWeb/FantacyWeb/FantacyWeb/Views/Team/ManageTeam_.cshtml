    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

@Html.Hidden("Rule_WicketKeeper")
@Html.Hidden("Rule_MaxBatsman")
@Html.Hidden("Rule_MinBatsman")
@Html.Hidden("Rule_MaxBowler")
@Html.Hidden("Rule_MinBowler")
@Html.Hidden("Rule_MaxAllrounder")
@Html.Hidden("Rule_MinAllrounder")
@Html.Hidden("Rule_MaxSameTeamPlayer")
@Html.Hidden("Rule_MaxOverseasPlayer")
@Html.Hidden("Rule_SubCount")

@Html.Hidden("SelectedPlayerCnt")
@Html.Hidden("Selectedwk")
@Html.Hidden("SelectedBat")
@Html.Hidden("SelectedBowl")
@Html.Hidden("SelectedAll")

@Html.Hidden("OverSeasPlayer")

@Html.Hidden("NitroLeft")
@Html.Hidden("AutoPilotLeft")
@Html.Hidden("PainKillerLeft")

@Html.Hidden("NitroUsed")
