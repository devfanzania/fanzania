
@{
    ViewBag.Title = "AutoTeamAddEdit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



<div class="forms-main">
    <div class="forms-inner">
        <div class="set-1">
            <div class="graph-2 general">
                <div class="row">
                    <div class="col-md-6">
                        <h3 class="inner-tittle text-left">Player List</h3>
                    </div>
                    <div class="text-right pull-right col-md-6">
                        <a href="/AdminAutoTeam/Index" class="back-team-btn"><i class="fa fa-arrow-left"></i>Back</a>
                    </div>
                </div>
                <div class="grid-1">
                    <div class="form-body">
                        <div class="row form-group">
                            <div class="parts-selector col-md-12" id="parts-selector-1">
                                <div class="parts list">
                                    <h3 class="list-heading">Available players</h3>
                                    <div style="padding: 1px 2px;">
                                        <input id="txtPlayerSearch" type="text" class="form-control" oninput="filterPlayer();" placeholder="type to search" />
                                    </div>
                                    <ul id="ulplayers"></ul>
                                </div>
                                <div class="controls">
                                    <a class="moveto selected"><span class="icon"></span><span class="text">Add</span></a>
                                    <a class="moveto parts"><span class="icon"></span><span class="text">Remove</span></a>
                                </div>
                                <div class="selected list">
                                    <h3 class="list-heading">Chosen players</h3>
                                    <ul id="ulSelPlayers"></ul>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-3"><label for="ddlCapList" class="control-label">Select Captain</label></div>
                            <div class="col-md-3"><select id="ddlCapList" class="form-control"></select></div>
                            <div class="col-md-3"><label for="ddlVCapList" class="control-label">Select Vice Captain</label></div>
                            <div class="col-md-3"><select id="ddlVCapList" class="form-control"></select></div>
                        </div>
                        <div class="form-group text-right">
                            <div class="col-md-12"><button id="btnSaveAutoteam" type="button" class="btn btn-info" onclick="SaveTeam();">Save Team</button></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        //debugger;
        var Tid = '@Session["AutoTeamTourId"].ToString()';
        sessionStorage.setItem("AutoTeamTournamentId", Tid);
        LoadPlayer(Tid);
    });
    var TeamDet = new Array();
    var jsonPlayers;
    function LoadPlayer(Tid) {
        
        var pData = { TournamentId: Tid };
        $.ajax({
            url: '/AdminAutoTeam/GetAllPlayers',
            type: 'POST',
            data: pData,
            dataType: 'json',
            async: false,
            success: function (data) {
                jsonPlayers = data;
                $.each(data, function (index, value) {
                    $('#ulplayers').append($("<li></li>").val(value.PlayerId).html(value.PlayerShortName + ' | ' + value.PlayerType + ' | ' + value.PlayerSpeciality + ' | ' + value.TeamShortName + ' | ' + value.PlayerValue));
                });
                $("#parts-selector-1").partsSelector({
                    callback: function () {
                       // alert($(this).html());
                        AddSelection();
                    }
                });
            },
            error: function (req, status, error) {
                alert('Unable to connect server!');
                return false;
            }
        });
    }
    function AddSelection() {
        //debugger;
        $('#ddlCapList').empty(); $('#ddlVCapList').empty();
        $('#ddlCapList').append($("<option></option>").val('').html("Select Player"));
        $('#ddlVCapList').append($("<option></option>").val('').html("Select Player"));
        $('#ulSelPlayers li').each(function () {
            //CheckLogic($(this).html());
            $('#ddlCapList').append($("<option></option>").val($(this).val()).html($(this).html()));
            $('#ddlVCapList').append($("<option></option>").val($(this).val()).html($(this).html()));
        });
        
    }
    function filterPlayer() {
        var inputText = $.trim($('#txtPlayerSearch').val());
        var data = jsonPlayers;
        if (inputText != "") {
            data = $.grep(jsonPlayers, function (n, i) {
                
                var re = new RegExp(inputText, "i");
                if (re.test(n.PlayerName))
                    return n;
            });
        }
        $('#ulplayers').empty();
        $.each(data, function (index, value) {
            $('#ulplayers').append($("<li></li>").val(value.PlayerId).html(value.PlayerName));
        });
    }


    function SaveTeam() {
        TeamDet.length = 0;
        var playerCnt = 0; var wkCnt = 0; var batCnt = 0; var bwlCnt = 0; var allCnt = 0; var budgetCnt = 0; var typeLocal = 0; var typeOver = 0;



        $('#ulSelPlayers li').each(function () {

            var res = $(this).html();
            var Astr = res.split("|");
            playerCnt = playerCnt + 1;
            if (Astr[2].trim() == 'wicketkeeper') { wkCnt = wkCnt + 1; }
            if (Astr[2].trim() == 'batsman') { batCnt = batCnt + 1; }
            if (Astr[2].trim() == 'bowler') { bwlCnt = bwlCnt + 1; }
            if (Astr[2].trim() == 'allrounder') { allCnt = allCnt + 1; }

            if (Astr[1].trim() == 'local') { typeLocal = typeLocal + 1; }
            if (Astr[1].trim() == 'overseas') { typeOver = typeOver + 1; }

            budgetCnt = parseInt(budgetCnt) + parseInt(Astr[4].trim());
            CalculateSameTeamPlayer(Astr[3].trim());
        });
        
        //console.log(playerCnt, wkCnt, batCnt, bwlCnt, allCnt, budgetCnt, typeLocal, typeOver);
        //console.log(TeamDet);

        

            var maxlimit_flag = 0; var maxteam = '';
            if (TeamDet.length > 0) {
                for (var i = 0; i < TeamDet.length; i++) {
                    if (TeamDet[i][1] > 6) {
                        maxlimit_flag = 1;
                        maxteam = TeamDet[i][0];
                    }
                }
            }

            if (playerCnt != 11) {
                alert('Please select 11 players');
                return;
            }
            else if (maxlimit_flag === 1) {
                // alert('');
                alert('Max player limit from team ' + maxteam + ' is crossed');
                return;
            }
            else if (parseInt(wkCnt) != 1) {
                //toastr_info('You have to select atleast one Wicketkeeper');
                alert('You have to select atleast one Wicketkeeper');
                return;
            }
            else if (parseInt(batCnt) > 5 || parseInt(batCnt) < 3) {
                // toastr_info('You have to select atleast three Batsman');
                alert('You have to select atleast 3-5 Batsman');
                return;
                }
            else if (parseInt(bwlCnt) > 5 || parseInt(bwlCnt) < 3) {
                //toastr_info('You have to select atleast three Bowler');
                alert('You have to select atleast 3-5 Bowler');
                return;
                }
            else if (parseInt(allCnt) > 3 || parseInt(allCnt) < 1) {
                //toastr_info('You have to select atleast one Allrounder');
                alert('You have to select atleast 1-3 Allrounder');
                return;
            }
            else if (parseInt(typeOver) > 4) {
                //toastr_info('You have to select atleast one Allrounder');
                alert('Only 4 overseas players are allowed');
                return;
            }
        

        //debugger;
        var capt = $('#ddlCapList').val();
        var vcapt = $('#ddlVCapList').val();
        if (capt == '') {
            alert('Please select your captain');
            return;
        }
        if (vcapt == '') {
            alert('Please select your vice captain');
            return;
        }
        if (capt == vcapt) {
            alert('You cannot use same player as captain and vice captain');
            return;
        }

        var playerXML = "<Team><Players ";
        var i = 1;
        $('#ulSelPlayers li').each(function () {
            playerXML += " Player" + i + " = '" + $(this).val() + "' ";
            i++;
        });
        playerXML += "/></Team>";
        //console.log(playerXML);
        //$('#spinnerContainer').show();
        var pData = { playerXML: playerXML, TeamCapt: capt, TeamVCapt: vcapt };
        $.ajax({
            url: '/AdminAutoTeam/SaveAutoTeam',
            type: 'POST',
            data: pData,
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.status = 'Success') {
                    alert('Player uploaded successfuly!');
                    location.replace('/AdminAutoTeam/Index');
                  
                }
               
            },
            error: function (req, status, error) {
                var str = "Req:" + req + ", Status:" + status + ", Error:" + error;
                alert(JSON.stringify(req));
                //alert('Unable to connect server!');
                //$('#spinnerContainer').hide();
            }
        })

    }

    function CalculateSameTeamPlayer(PTeam) {
        //debugger;
            var teamcnt = TeamDet.length;
            var flag = 0;
            if (teamcnt == 0) {
                TeamDet[teamcnt] = new Array(PTeam, 1);
                flag = 1;
            }
            else {
                for (var i = 0; i < TeamDet.length; i++) {
                    if (TeamDet[i][0] === PTeam) {
                        var cnt_flag = TeamDet[i][1];
                        cnt_flag = cnt_flag + 1;
                        TeamDet[i][1] = cnt_flag;
                        flag = 1;
                    }
                }
            }
            if (flag == 0) {
                TeamDet[teamcnt] = new Array(PTeam, 1);
            }
    }


</script>