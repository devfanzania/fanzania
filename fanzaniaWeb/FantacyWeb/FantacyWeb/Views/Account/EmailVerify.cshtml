@model Fantacy_Model.EmailVerify
@{
    ViewBag.Title = "EmailVerify";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<style>
    .frmVerify .form-bottom1 {
        padding: 25px 25px 30px 25px;
        background: #fff;
        -moz-border-radius: 0 0 4px 4px;
        -webkit-border-radius: 0 0 4px 4px;
        border-radius: 0 0 4px 4px;
        text-align: left;
        float: left;
        width: 100%;
        flex: 1;
        /* z-index: 9; */
        margin-top: 20px;
        height: 190px;
    }
    .form-bottom1 .form-control {
        border: 1px solid #f39206;
        background: #fff;
        border-radius: 30px;
    }
    .form-bottom1 form button.btn {
        display: block;
        margin: 0 auto;
        text-align: center;
        border-radius: 50px;
    }
</style>


<div class="inner-bg">
    <div class="container register">
        <div class="row">
            <div class="col-md-3 register-left">
                <img src="https://image.ibb.co/n7oTvU/logo_white.png" alt="" />
                <h3>Welcome</h3>
                <p>You are 30 seconds away from earning your own points!</p>

            </div>
            <div class="col-md-9 register-right frmVerify">
                <div class="top-content">
                    <div class="container">
                        <div class="row">
                            <div class="col-sm-10 col-sm-offset-1 form-box">
                                <div class="form-top">
                                    <div class="form-top-left">
                                        <h3>Verify your email here</h3>
                                        <p>A verification code has been sent to your email : @ViewBag.Email</p>
                                    </div>
                                    <div class="form-top-right">
                                        <i class="fa fa-key"></i>
                                    </div>
                                </div>
                                <div class="form-bottom1">
                                    <form id="frmVerify" method="post">
                                        
                                        <div class="form-group">
                                            @Html.PasswordFor(m => m.VerificationCode, new { @class = "form-firstname form-control", placeholder = "Verification Code..." })
                                            @Html.ValidationMessageFor(m => m.VerificationCode)

                                        </div>
                                        <div class="form-group" style="margin-bottom: 0px;">
                                            <span class="field-validation-error">@ViewBag.Message</span>
                                        </div>
                                        <button id="btnVerify" type="submit" class="btn btn-sign-in">Verify</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>