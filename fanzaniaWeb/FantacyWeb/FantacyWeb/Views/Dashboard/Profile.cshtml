@model Fantacy_Model.ProfileModel
@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<section>
    <div class="container">
        <div class="dashboardStat">
            <div class="row">
                <div class="col-md-3 ">
                    <div class="col-sm-10 col-sm-offset-1 profile-image">
                        <img src="~/images/1.jpg" />
                    </div>
                </div>

                <div class="col-md-9">
                    <div class="col-sm-10 col-sm-offset-1 form-box">
                        <div class="form-bottom-profile">
                            <form id="frmregister" method="post">
                                <div class="form-group">
                                    <span class="field-validation-error">@ViewBag.Message</span>
                                </div>
                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-firstname form-control", placeholder = "Name..." })
                                    @Html.ValidationMessageFor(m => m.Name)
                                </div>
                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-phone form-control", placeholder = "Email..." })
                                    @Html.ValidationMessageFor(m => m.Email)
                                </div>
                                <div class="form-group">
                                    @Html.TextBoxFor(model => model.DOB, new { @class = "form-control", id = "dob", placeholder = "Enter Dob...", autocomplete = "off" })
                                    @Html.ValidationMessageFor(m => m.DOB)
                                </div>
                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control form-Email", placeholder = "Mobile...", maxLength = "11" })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber)
                                </div>
                                <div class="form-group">
                                    @Html.DropDownListFor(m => m.CountryId, new SelectList(Model.Countrylist, "CountryId", "Country"), "- Please Country -", new { @class = "form-control form-country" })
                                    @Html.ValidationMessageFor(m => m.CountryId)
                                </div>
                                <button id="btnSave" type="submit" class="btn btn-profile-save">Save</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    $(function () {
        $("#dob").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "yyyy/mm/dd/",
            yearRange: '1960:' + (new Date).getFullYear()
        });
    });
</script>



