
@{
    ViewBag.Title = "TournamentStat";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}


<section class="inner-wrap">
    <div class="container">
        <div class="dashboardStat">
            <div class="row">
                <div class="col-md-6 text-left"><a href="/Dashboard/Index" class="back-team-btn"><i class="fa fa-arrow-left"></i>  Back to Home</a></div>
            </div>
            <div class="row">
               <div class="responsive-tabs-1">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active">
                                <a href="#tab1" aria-controls="tab1" role="tab" data-toggle="tab">Global Top Players</a>
                            </li>
                            <li role="presentation" class="">
                                <a href="#tab2" aria-controls="tab2" role="tab" data-toggle="tab">Global Top Teams</a>
                            </li>
                            <li role="presentation" class="">
                                <a href="#tab3" aria-controls="tab3" role="tab" data-toggle="tab">Global Top Leagues</a>
                            </li>
                        </ul>
                        <div id="tabs-content" class="tab-content panel-group">
                            <div class="panel-heading" role="tab" id="heading1">
                                <a href="#tab1" class="" role="button" data-toggle="collapse" data-parent="tabs-content" aria-expanded="true"
                                   aria-controls="tab1">Global Top Players</a>
                            </div>
                            <div id="tab1" role="tabpanel" class="tab-pane active panel-collapse collapse in" aria-labelledby="heading1">
                                <div class="row">
                                    <div class="" id="divLeague">
                                        <div class="col-md-12 text-center">
                                            <div class="table-responsive statTable"><table id="Global_Top_Ten_Players"></table></div>
                                        </div>
                                        
                                    </div>
                                </div>
                            </div>
                            <div class="panel-heading" role="tab" id="heading2">
                                <a href="#tab2" class="collapsed" role="button" data-toggle="collapse" data-parent="tabs-content"
                                   aria-expanded="true" aria-controls="tab2">Global Top Teams</a>
                            </div>
                            <div id="tab2" role="tabpanel" class="tab-pane panel-collapse collapse" aria-labelledby="heading2">
                                <div class="row">
                                    <div class="" id="tourStat">
                                        <div class="col-md-6 text-center">
                                            <div class="table-responsive statTable"><table id="Global_Top_Teams"></table></div>
                                        </div>
                                        <div class="col-md-6 text-center">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <ul id="" class="text-center panel-info-final" >
                                                        <li class="text-uppercase" id="transferLeft" style="padding: 0 22px !important;"></li>
                                                        <li class="text-uppercase" id="lastMatchPoint" style="padding: 0 22px !important;"></li>
                                                        <li class="text-uppercase" id="powerPlay" style="padding: 0 22px !important;"></li>
                                                        <li class="text-uppercase" id="winnerPrediction" style="padding: 0 22px !important;"></li>

                                                    </ul>
                                                </div>
                                                <div id="MyTeamView" class="row">

                                                    <div class="col-md-12 d-ground4">
                                                        <div class="playground-team">
                                                            <div class="dGroundPalyers">
                                                                <div id="Players">
                                                                </div>
                                                            </div>
                                                            <div class="team-indicates">
                                                                <div class="team-indicate">
                                                                    <img src="~/Assets/Icon/WicketkeeperGrey.png" />
                                                                </div>
                                                                <div class="team-indicate2">
                                                                    <img src="~/Assets/Icon/BatsmanGrey.png" />

                                                                </div>
                                                                <div class="team-indicate3">
                                                                    <img src="~/Assets/Icon/BowlerGrey.png" />
                                                                </div>
                                                                <div class="team-indicate4">
                                                                    <img src="~/Assets/Icon/AllrounderGrey.png" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="panel-heading" role="tab" id="heading2">
                                <a href="#tab3" class="collapsed" role="button" data-toggle="collapse" data-parent="tabs-content"
                                   aria-expanded="true" aria-controls="tab2">Global Top Leagues</a>
                            </div>
                            <div id="tab3" role="tabpanel" class="tab-pane panel-collapse collapse" aria-labelledby="heading2">
                                <div class="row">
                                    <div class="" id="divLeague">
                                        <div class="col-md-12 text-center">
                                            <div class="table-responsive statTable"><table id="Global_Top_Leagues"></table></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
            </div>
        </div>
    </div>
</section>
<div id="spinnerContainer" class="spinnerContainer" style="display: none;">
    <div id="spinner" class="spinner">
        <img id="img-spinner" src="~/Assets/Icon/ball.gif" alt="Loading" />
    </div>
</div>


<script>

    // Instanciation
    $(document).ready(function () {
        $('.responsive-tabs-1-1').responsiveTabs();

        var Tid = '@Session["Tid_Stat"].ToString()';
        PageLoad(Tid);
    });
</script>
<script src="~/CustomScript/Dashboard/TournamentStat.js"></script>