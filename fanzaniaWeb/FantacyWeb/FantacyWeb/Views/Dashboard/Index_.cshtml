
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="sec1">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="sec1-banner-left">
                    <h1>FANTASY<br>CRICKET FOR<br>EVERYONE<span>.</span></h1>
                    <h2 class="o-bg-text">ZERO FEES.</h2>
                    <h2 class="b-bg-text">INFINITE FUN.</h2>
                </div>
            </div>
            <div class="col-md-8">
                <div class="sec1-banner-right">
                    <div class="sec1-right-txt ">
                        <div class="tag-start-match row">
                            <h3>IPL 2020 <span>Starts 19 September</span></h3>
                            <h4><strong>REFER AND WIN<br><span>INR 100*</span></strong></h4>
                        </div>
                    </div>

                    <div class="sec1-contest">
                        <h3>Match contest<span>.</span></h3>
                        <p><strong>INR 35000+</strong> PRIZES <span>|</span> TOP 3 WINNERS EACH MATCH </p>
                    </div>

                    <div class="sec1-tournament">
                        <h3>tournament mode<span>.</span></h3>
                        <p><strong>INR 24000+</strong> PRIZES <span>|</span> TOP 20 WINNERS </p>
                    </div>

                    <div class="sec1-btn-part">
                        <a href="https://play.google.com/store/apps/details?id=com.yorker.fanzania" target="_blank" class="btn btn-border">
                            <i class="fa fa-android"></i>Download on <br>Google Play
                        </a>
                        <a href="https://itunes.apple.com/gb/app/fanzania/id1464445305?mt=8" target="_blank" class="btn btn-border">
                           <i class="fa fa-apple"></i> Download on <br>App Store
                        </a>
                        <a href="~/Account/Register" class="btn btn-red pull-right">
                            Sign Up
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="sec2">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2">
                <h1>Indian Premier League. <span>2020</span></h1>
            </div>
            <div class="col-md-5">
                <div class="row">
                    <div class="sec2-black">
                        <h2>MATCH CONTESTS<span>.</span> </h2>
                        <ul>
                            <li>Pick your match.</li>
                            <li>Select your team.</li>
                            <li>Track your points LIVE.</li>
                            <li>Top 3 teams get prizes.</li>
                        </ul>
                        <div class="inr-area">
                            <div class="inr1">
                                <p>
                                    INR<br>
                                    300
                                </p>
                            </div>
                            <div class="inr2">
                                <p>
                                    INR<br>
                                    200
                                </p>
                            </div>
                            <div class="inr3">
                                <p>
                                    INR<br>
                                    100
                                </p>
                            </div>
                            <p class="inr-tag">each match.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="row">
                    <div class="sec2-orange">
                        <h2>TOURNAMENT<span>.</span> </h2>
                        <ul>
                            <li> Select your team.</li>
                            <li>120(+10) subs + 3 PowerPlays.</li>
                            <li> Play in leagues with friends.</li>
                            <li>Top 20 teams get prizes.</li>
                        </ul>
                        <div class="inr-area2">
                            <div class="inr1">
                                <p>
                                    INR<br>
                                    8K
                                </p>
                            </div>
                            <div class="inr2">
                                <p>
                                    INR<br>
                                    4K
                                </p>
                            </div>
                            <div class="inr3">
                                <p>
                                    INR<br>
                                    2K
                                </p>
                            </div>
                            <p class="inr-tag">and many more.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="sec3">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="testimonial">
                    <div class="owl-carousel owl-theme testimonial-carousel">
                        <div class="item">
                            <div class="user">
                                <img src="../Assets/Image/testimonial-user.png" alt="" />
                            </div>
                            <div class="testimonial-text">
                                <p>Thank you guys for organizing such lovely fantasy tournament. We dearly missed this format during the IPL but you guys
                                 came to our rescue for the World Cup.
                                #EngvNZ #Cwc19 #Fantasy #playfanzania
                                </p>
                            </div>
                            <div class="testimonial-author">
                                <h4>Samrudh</h4>
                            </div>
                        </div>
                        <div class="item">
                            <div class="user">
                                <img src="../Assets/Image/testimonial-user.png" alt="" />
                            </div>
                            <div class="testimonial-text">
                                <p>One of the best user friendly fantacy app i have come across... Especially the tournament mode, which is not found elsewhere...
                                </br>Tournament mode was being missed after playing fantacy cricket initially on other platforms.. these days we do not find this gameplay 
                                on popular platforms. </p>
                            </div>
                            <div class="testimonial-author">
                                <h4>Siddhartha</h4>
                            </div>
                        </div>
                        

                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="row">
                    <div class="col-md-6">
                        <div class="sec3-orange">
                            <h3>ZERO FEES. </h3>
                            <p>
                                It’s free for you to play.
                                24x7. 365 days.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sec3-orange">
                            <h3>
                                NO LOCATION
                                RESTRICTIONS.
                            </h3>
                            <p>
                                Unlike other fantasy
                                cricket apps, our apps
                                work from most countries.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sec3-orange">
                            <h3>UNIQUE FEATURES. </h3>
                            <p>
                                We have ‘never seen before’
                                features to bring the best
                                out of your cricket
                                knowledge.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sec3-orange">
                            <h3>LOYALTY SCHEME.  </h3>
                            <p>
                                Personalised points wallet
                                to make your playing
                                experience even more
                                rewarding.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sec3-orange">
                            <h3>LIVE SCORING.  </h3>
                            <p>
                                Live scoring for matches
                                and league standings.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sec3-orange">
                            <h3>
                                PLAY ON
                                ANY DEVICE.
                            </h3>
                            <p>
                                We have Android, iOS and
                                web versions. Play your
                                game the way you wish.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
	 $(document).ready(function() {
              $('.testimonial-carousel').owlCarousel({
                loop: true,
                margin: 10,
                nav: false,
                autoplay: true,
                autoplayduration:1000,
                responsiveClass: true,
                responsive: {
                  0: {
                    items: 1,
                    nav: false
                  },
                  600: {
                    items: 1,
                    nav: false
                  },
                  1000: {
                    items: 1,
                    nav: false,
                    loop: true,
                    margin: 20
                  }
                }
              })
            })
</script>