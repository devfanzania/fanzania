<style>

    .btn-red {
        background: linear-gradient(to left, #fa3f45 0%,#ff9000 100%);
        color: #fff;
        border-radius: 20px;
        width: 138px;
        margin: 2px 0;
        float: right;
        height: 30px;
        font-weight: 600;
    }

    .canvasjs-chart-credit {
        display: none !important;
    }
    .charttab {
        border-right: 1px solid #ec0909;
        padding-right: 10px;
        color: #ec0909;
        font-weight: 500;
    }
    .dec {
      
        color: black !important;
        font-size: 12px;
    }
    .titlesideimage {
        position: absolute;
        z-index: 999;
        top: 17px;
        opacity: 1;
        padding-left: 4px;
    }
    .showteam {
        position: absolute;
        z-index: 999;
        right: 58px;
        top: 21px;
        opacity: 1;
        font-size: 11px;
    }
    .total {
        font-size: 12px;
        font-weight:700;
    }
    .tab-content {
         padding: 0px !important; 
    }
    .spanall {
        color: #fa3f45;
    }
    .hr {
        margin-top: 6px;
        margin-bottom: 6px;
        border-top: 1px solid #eeeeee;
        border: revert !important;
    }
    .btn3:hover {
        text-decoration: none;
        background: linear-gradient(to left, #fa3f45 0%,#ff9000 100%) !important;
        color: #fff;
    }
   
</style>
