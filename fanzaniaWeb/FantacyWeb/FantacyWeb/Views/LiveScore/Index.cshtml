<section id="TournamentSlider" class="inner-wrap">
    <div class="container">
        <div class="banner-slider">
            <div class="row">
                <div class="col-md-12">

                    <div class="carousel slide multi-item-carousel" data-interval="false" data-wrap="false" id="theCarousel">
                        <div id="TournamentBox" class="carousel-inner">

                        </div>
                    </div>
                    <a id="TournamentSlide_prev" class="left carousel-control" href="#theCarousel" data-slide="prev" onclick="OnChangeTournamentSlide('prev');"><i class="fa fa-angle-left"></i></a>
                    <a id="TournamentSlide_next" class="right carousel-control" href="#theCarousel" data-slide="next" onclick="OnChangeTournamentSlide('next');"><i class="fa fa-angle-right"></i></a>
                </div>

            </div>
        </div>
    </div>

</section>
<section>
    <div class="container">
        <div class="team-heading">
            <div class="row">
                @*<div class="col-md-3">
