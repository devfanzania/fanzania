@Html.Hidden("TournamentId")
@Html.Hidden("UniqueId")
<div class="forms-main">
    <div class="forms-inner">
        <div class="set-1">
            <div class="graph-2 general">
                <h3 class="inner-tittle">Match Control</h3>
                <div class="grid-1">
                    <div class="form-body">
                            @*<div class="row form-group">
                                <div class="col-md-3">
                                    <label class="control-label1">Game Type</label>
                                </div>
                                <div class="col-md-3">

                                    <select id="ddlGameType" class="form-control1">
                                        <option value="T">Tournament</option>
                                        <option value="D">Daily Match</option>
                                    </select>
                                </div>
                            </div>*@
                            <div class="row form-group">
                                @*<div class="col-md-3">
                                    <label for="ddlTourList" class="control-label">Select Tournament</label>
                                </div>
                                <div class="col-md-3">
                                    <select id="ddlTourList" class="form-control1"></select>
                                </div>*@
                                <div class="col-md-3">
                                    <select id="ddlUpcomMatchList" class="form-control1"></select>
                                </div>
                                <div class="col-md-3">
                                    <select id="ddlLiveMatchList" class="form-control1"></select>
                                </div>
                                <div class="col-md-3 text-center">
                                    <button id="btn_MCalculation" class="btn btn-block btn-info" onclick="ManualPointCalculation()" ;> Manual Point Calculation</button>
                                </div>
                                <div class="col-md-3 text-center">
