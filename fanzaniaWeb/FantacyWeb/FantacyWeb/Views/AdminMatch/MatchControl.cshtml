                                </div>
                            </div>
                            <div class="row from-group">
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-3 text-center">

                                </div>
                                <div class="col-md-3 text-center">
                                    <button id="btn_hideScore" class="btn btn-block btn-info" onclick="HideScore()" ;> Hide Score</button>
                                </div>

                            </div>


                        </div>
                </div>
                <h3 class="inner-tittle">Saved Match List</h3>
                <div class="grid-1">
                    <div class="row form-group">
                        <div class="col-md-3">
                            <label for="txt_UniqueId" class="control-label">Unique Id</label>
                            <input type="text" class="form-control1" id="txt_UniqueId" readonly="readonly">
                        </div>
                        <div class="col-md-3">
                            <label for="txt_Type" class="control-label">Type</label>
                            <input type="text" class="form-control1" id="txt_Type" readonly="readonly">
                        </div>
                        <div class="col-md-3">
                            <label for="txt_Date" class="control-label">Date</label>
                            <input type="text" class="form-control1" id="txt_Date" readonly="readonly">
                        </div>
                        <div class="col-md-3">
                            <label for="txt_Status" class="control-label">Status</label>
                            <input type="text" class="form-control1" id="txt_Status" readonly="readonly">
                        </div>

                    </div>
                    <div class="row form-group">
                        <div class="col-md-3">
                            <label for="txt_Team1" class="control-label">Team 1</label>
                            <input type="text" class="form-control1" id="txt_Team1" readonly="readonly">
                            <input type="checkbox" id="chk_Team1" class="radio" value="1" name="capvs[1][]" />
                        </div>
                        <div class="col-md-3">
                            <label for="txt_Team2" class="control-label">Team 2</label>
                            <input type="text" class="form-control1" id="txt_Team2" readonly="readonly">
                            <input type="checkbox" id="chk_Team2" class="radio" value="1" name="capvs[1][]" />
                        </div>
                        <div class="col-md-3">
                            <label for="ddl_Inngs" class="control-label">Innings</label>
                            <select name="selector2" id="ddl_Inngs" class="form-control1"></select>
                        </div>
                        <div class="col-md-3 text-right">
                            
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-3">
                            <button id="btn_SwitchTeam" class="btn btn-info" onclick="SwitchBattingTeam()" ;> Switch Batting Team</button>
                        </div>
                        <div class="col-md-3">
                            <button id="btn_tossWinner" class="btn btn-info" onclick="TossWinner()" ;>Toss Winner</button>
                        </div>
                        <div class="col-md-3 text-right">
                            <button id="btn_FinishMatch" class="btn btn-info" onclick="FinishMatch()";> Finish Match</button>
                        </div>
