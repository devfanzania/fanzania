<script>

    $(document).ready(function () {
        $('#ddlLiveMatchList').empty();
        $('#ddlUpcomMatchList').empty();

        $('#btn_StartMatch').attr("disabled", "disabled");
        $('#btn_MCalculation').attr("disabled", "disabled");
        $('#btn_Calculation').attr("disabled", "disabled");
        $('#btn_FinishMatch').attr("disabled", "disabled");

        $('#btn_hideScore').attr("disabled", "disabled");
        $('#btn_tossWinner').attr("disabled", "disabled");

        LoadMatch(0, 'UPCOMING');
        LoadMatch(0, 'Live');
    });
   
   
    function LoadMatch(Tid, matchStatus) {
        var pData = { TournamentId: Tid, MatchStatus: matchStatus};
        //var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/GetMatch',
            type: 'POST',
            data: pData,
            dataType: 'json',
            async: true,
            success: function (data) {
                if (matchStatus == 'UPCOMING') {
                    $('#ddlUpcomMatchList').empty();
                    $('#ddlUpcomMatchList').append($("<option></option>").val('').html("Select Upcomming Match"));
                    $.each(data, function (index, value) {
                        $('#ddlUpcomMatchList').append($("<option></option>").val(value.UniqueId).html(value.MatchScheduledDate + ' - ' + value.Team1 + ' vs ' + value.Team2));
                    });
                }
                else {
                    $('#ddlLiveMatchList').empty();
                    $('#ddlLiveMatchList').append($("<option></option>").val('').html("Select Live Match"));
                    $.each(data, function (index, value) {
                        $('#ddlLiveMatchList').append($("<option></option>").val(value.UniqueId).html(value.MatchScheduledDate + ' - ' + value.Team1 + ' vs ' + value.Team2));
                    });
                }
            },
            error: function (req, status, error) {
                alert('Unable to connect server!');
            }
        });
    }

    $("#ddlLiveMatchList").change(function () {
        GetMatchDetail($('#ddlLiveMatchList').val());
        $('#ddlUpcomMatchList').val('');
        $('#btn_StartMatch').attr("disabled", "disabled");
        $('#btn_MCalculation').removeAttr("disabled");
        $('#btn_Calculation').removeAttr("disabled");
        $('#btn_FinishMatch').removeAttr("disabled");
        $('#btn_hideScore').removeAttr("disabled");
        $('#btn_tossWinner').attr("disabled", "disabled");
    });
    $("#ddlUpcomMatchList").change(function () {
        GetMatchDetail($('#ddlUpcomMatchList').val());
        $('#ddlLiveMatchList').val('');
        $('#btn_StartMatch').removeAttr("disabled");
        $('#btn_MCalculation').attr("disabled", "disabled");
        $('#btn_Calculation').attr("disabled", "disabled");
        $('#btn_FinishMatch').attr("disabled", "disabled");
        $('#btn_tossWinner').removeAttr("disabled");
        $('#btn_hideScore').attr("disabled", "disabled");
    });

    function GetMatchDetail(ddlval) {
        $('#txt_UniqueId').val('');
        $('#txt_Type').val('');
        $('#txt_Date').val('');
        $('#txt_Team1').val('');
        $('#txt_Team2').val('');
        $('#txt_Status').val('');
        $('#chk_Team1').prop("checked", false);
        $('#chk_Team2').prop("checked", false);
        $('#ddl_Inngs').empty();

        //var ddlval = $('#ddlLiveMatchList').val();
        $('#UniqueId').val(ddlval);
        if (ddlval != '') {
            var pData = { UniqueId: ddlval };
            //var jsonData = JSON.stringify(pData);
            $.ajax({
                url: '/AdminMatch/GetMatchDeatils',
                type: 'POST',
                data: pData,
                dataType: 'json',
                async: true,
                success: function (data) {

                    $('#txt_UniqueId').val(data[0]["UniqueId"]);
                    $('#txt_Type').val(data[0]["MatchType"]);
                    $('#txt_Date').val(data[0]["MatchScheduledDate"]);
                    $('#txt_Team1').val(data[0]["Team1"]);
                    $('#txt_Team2').val(data[0]["Team2"]); //$('#chk_Team2').val(data[0]["Team2"]);
                    $('#txt_Status').val(data[0]["MatchStatus"]);
                    if (data[0]["Inning1BattingTeam"] != null) {
                        $('#btn_SwitchTeam').removeAttr("disabled");
                        if (data[0]["Team1"] == data[0]["Inning1BattingTeam"]) {
                            $('#chk_Team1').prop("checked", true);
                            $('#chk_Team2').prop("checked", false);
                        }
                        if (data[0]["Team2"] == data[0]["Inning1BattingTeam"]) {
                            $('#chk_Team1').prop("checked", false);
                            $('#chk_Team2').prop("checked", true);
                        }
                    } else {
                        $('#btn_SwitchTeam').attr("disabled", "disabled");
                        $('#chk_Team1').prop("checked", false);
                        $('#chk_Team2').prop("checked", false);
                    }

                    var innlist = '';
                    if (data[0]["MatchType"] == 'TEST') {
                        innlist = '<option value="1">1st Innings</option><option value="2">2nd Innings</option><option value="3">3rd Innings</option><option value="4">4th Innings</option>';
                    } else {
                        innlist = '<option value="1">1st Innings</option><option value="2">2nd Innings</option>';
                    }
                    $('#ddl_Inngs').html(innlist);
                },
                error: function (req, status, error) {
                    alert('Unable to connect server!');
                }
            });
        }


    }

    function StartInnings() {
        var innVal = $('#ddl_Inngs').val();
        ChangeStatus(innVal);
    }
    function FinishMatch() {
       ChangeStatus('5');
    }

    function ChangeStatus(innVal) {

        var Innteam = '';
        if (chk_Team1.checked) {
            Innteam = $('#txt_Team1').val();
        }
        if (chk_Team2.checked) {
            Innteam = $('#txt_Team2').val();
        }
        //var innVal = $('#ddl_Inngs').val();
        var Tid = $('#TournamentId').val();
        var UniqueId = $('#UniqueId').val();
        //var Mno = $('#txt_MatchNo').val();

        var pData = { BattingTeam: Innteam, Inning: innVal, TournamentId: Tid, UniqueId: UniqueId };
        //var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/MatchStart',
            type: 'POST',
            data: pData,
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.status == "success") {
                    alert('Innings Started!');
                    location.href = '/AdminMatch/MatchControl';
                }
                else {
                    alert(data.Error);
                }
            },
            error: function (req, status, error) {
                alert('Unable to connect server!');
            }
        });
    }

    function SwitchBattingTeam() {

           
        var Tid = $('#TournamentId').val();
        var UniqueId = $('#UniqueId').val();
        

        var pData = { TournamentId: Tid, UniqueId: UniqueId };
        //var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/SwitchBattingTeam',
            type: 'POST',
            data: pData,
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.status == "success") {
                    alert('Team Successfully switched!');
                    location.href = '/AdminMatch/MatchControl';
                }
                else {
                    alert(data.Error);
                }
            },
            error: function (req, status, error) {
                alert('Unable to connect server!');
            }
        });
    }


    $("input:checkbox").on('click', function () {
        // in the handler, 'this' refers to the box clicked on
        var $box = $(this);
        if ($box.is(":checked")) {
            // the name of the box is retrieved using the .attr() method
            // as it is assumed and expected to be immutable
            var group = "input:checkbox[name='" + $box.attr("name") + "']";
            // the checked state of the group/box on the other hand will change
            // and the current value is retrieved using .prop() method
            $(group).prop("checked", false);
            $box.prop("checked", true);
        } else {
            $box.prop("checked", false);
        }
    });

    function ManualPointCalculation() {

        var UniqueId = $('#UniqueId').val();
        if (UniqueId == '') {
            alert('Please select a match!');
            return;
        }
       
        var pData = { UniqueId: UniqueId };
        //var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/ManualPointCalculation',
            type: 'POST',
            data: pData,
            dataType: 'json',
            async: false,
            success: function (data) {
                if (data.status == "success") {
                    alert(data.statusMessage);
                }
                else {
                    alert(data.Error);
                }
            },
            error: function (req, status, error) {
                alert('Unable to connect server!');
            }
        });
    }

    function CalculatePoint() {
        var UniqueId = $('#UniqueId').val();
        if (UniqueId == '') {
            alert('Please select a match!');
            return;
        }
        /// $('#spinnerContainer').show();
        var pData = { UniqueId: UniqueId };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/CalculatePoints',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: false,
            // cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {

                if (data.status == "success") {
                    alert(data.statusMessage);
                }

            },
            error: function (req, status, error) {
                var str = "Req:" + req + ", Status:" + status + ", Error:" + error;
                alert(JSON.stringify(req));
                // $('#spinnerContainer').hide();
            }
        })
    }

    function TossWinner() {
        var UniqueId = $('#UniqueId').val();

        var tosswin = '';
        if (chk_Team1.checked) {
            tosswin = $('#txt_Team1').val();
        }
        if (chk_Team2.checked) {
            tosswin = $('#txt_Team2').val();
        }

        if (UniqueId == '') {
            alert('Please select a match!');
            return;
        }

        if (tosswin == '') {
            alert('Please select a team!');
            return;
        }

        /// $('#spinnerContainer').show();
        var pData = { UniqueId: UniqueId, TossWinnerTeam: tosswin };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/TossWinner',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: false,
            // cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {

                if (data.status == "success") {
                    alert(data.statusMessage);
                }

            },
            error: function (req, status, error) {
                var str = "Req:" + req + ", Status:" + status + ", Error:" + error;
                alert(JSON.stringify(req));
                // $('#spinnerContainer').hide();
            }
        })
    }

    function HideScore() {
        var UniqueId = $('#UniqueId').val();
        if (UniqueId == '') {
            alert('Please select a live match!');
            return;
        }

        /// $('#spinnerContainer').show();
        var pData = { UniqueId: UniqueId };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminMatch/HideScore',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: false,
            // cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {

                if (data.status == "success") {
                    alert(data.statusMessage);
                }

            },
            error: function (req, status, error) {
                var str = "Req:" + req + ", Status:" + status + ", Error:" + error;
                alert(JSON.stringify(req));
                // $('#spinnerContainer').hide();
            }
        })
    }
</script>

