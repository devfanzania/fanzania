<script>
    var Session_TournamentId = '';
    var Session_LeagueId = '';
    var Session_UserId = '';

    $(document).ready(function () {
        Session_LeagueId = @Session["LeagueId"].ToString();
        Session_TournamentId = @Session["TournamentId"].ToString();
        Session_UserId = @Session["UserId"].ToString();
        OnPageLoad();
        var Finalstorage = JSON.parse(localStorage.getItem("storagefinal"));
     //  console.log("data",Finalstorage);
       // return;
        if (Finalstorage != null) {
           // console.log("data", Finalstorage);
            var uurl = '/League/UpdateLeagueSubscription';
          //  var pData = { TournamentId: Tid };
            var jsonData = JSON.stringify(Finalstorage);
            $.ajax({
                url: uurl,
                type: 'POST',
                data: jsonData,
                dataType: 'json',
                async: true,
                cache: false,
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.status == 'success') {
                        localStorage.removeItem('storagefinal');
                        Finalstorage = '';
                        //console.log("dataafter update", Finalstorage);
                    }
                },
                error: function (req, status, error) {
                    $('#spinnerContainer').hide();
                    toastr_warning("Oops. We are unable to connect to our servers. Please try again.11!");
                    return false;
                }
            });


        }
    });

</script>

