        border-radius: 0;
        background-color: #fff;
        border-radius: 10px;
        height: 36px;
        display: block;
        width: 100%;
        height: 34px;
        padding: 6px 12px;
        font-size: 14px;
        line-height: 1.428571429;
        color: #555555;
        vertical-align: middle;
    }

    input[type=checkbox]:after {
        content: " ";
        background-color: #D7B1D7;
        display: inline-block;
        visibility: visible;
    }

    input[type='checkbox'] {
        width: 28px !important;
        height: 28px !important;
        margin: 4px;
        /* border-radius: 25px; */
        /* -webkit-appearance: none; */
        -moz-appearance: none;
        -o-appearance: none;
        appearance: none;
        /* outline: 1px solid gray; */
