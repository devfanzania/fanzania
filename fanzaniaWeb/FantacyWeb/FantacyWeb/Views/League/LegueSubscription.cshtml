    function discountcalculation(allplantotal) {
        var finaltotalall = $("#finaltotalall").text();
        $('#afterdiscounttotal').html(finaltotalall);
        var DiscountRate1 = $("#DiscountRate1").text();
        var DiscountRate2 = $("#DiscountRate2").text();
        var DiscountRate3 = $("#DiscountRate3").text();
        if (allplantotal > 20) {
            var totalValue = finaltotalall * ((100 - DiscountRate3) / 100)
            $('#afterdiscounttotal').html((totalValue).toFixed(2));
        } else if (allplantotal > 10) {
            var totalValue = finaltotalall * ((100 - DiscountRate2) / 100)
            $('#afterdiscounttotal').html((totalValue).toFixed(2));
        } else if (allplantotal >= 5) {
            var totalValue = finaltotalall * ((100 - DiscountRate1) / 100)
            $('#afterdiscounttotal').html((totalValue).toFixed(2));
        }

    }
    function addmapdata(rowid, package_amount, columid,UserId) {
        let obj = {
            UserId: UserId,
            colum: columid,
            amount: package_amount
        }
        var cb = [];
        if (map.has(rowid)) {
            var check = map.get(rowid);

            check.push(obj);
            map.set(rowid, check);
        } else {
            cb.push(obj);
            map.set(rowid, cb);
        }
        //total
        var gettotal = map.get(rowid);
        var total = 0;
        gettotal.forEach(function (item, index) {
            total = total + item.amount;
        });
        $('#rowcheckedtotalamount' + rowid).html(total);

        //final Total
        var finaltotal = 0;
        map.forEach((values, keys) => {
            values.forEach(function (item, index) {

                finaltotal = finaltotal + item.amount;
                //   console.log(finaltotal);
            })
        })
        $('#finaltotalall').html((finaltotal).toFixed(2));

    }
    function removemapdata(rowid, package_amount, columid) {
        if (map.has(rowid)) {
            var check = map.get(rowid);
            var newarray = []
            check.forEach(function (item, index) {
                if (item.colum != columid) {
                    newarray.push(item);
                }
            });
            map.set(rowid, newarray);
            //total
            var gettotal = map.get(rowid);
            var total = 0;
            gettotal.forEach(function (item, index) {
                total = total + item.amount;
            });
            $('#rowcheckedtotalamount' + rowid).html(total);

            //final Total
            var finaltotal = 0;
            map.forEach((values, keys) => {
                values.forEach(function (item, index) {

                    finaltotal = finaltotal + item.amount;
                    //  console.log(finaltotal);
                })
            })
            $('#finaltotalall').html(finaltotal);
        }
    }
