        font-size: 0.8em;
        text-align: center;
        line-height: 2em;
        background: green;
        border-radius: 15px;
    }

        input[type="checkbox"]:disabled:checked {
            width: 30px !important;
            height: 30px !important;
            margin: 4px;
            /* border-radius: 25px; */
            /* -webkit-appearance: none; */
            -moz-appearance: none;
            -o-appearance: none;
            appearance: none;
            /* outline: 1px solid gray; */
            /* box-shadow: none; */
            font-size: 0.8em;
            text-align: center;
            line-height: 2em;
            background-color: #ccc !important;
            border-radius: 15px;
        }

 input[type='checkbox']:disabled:checked:after {
                content: '✔';
                color: white;
                background-color: #ccc !important;
                font-size: 16px;
                margin-top: 2px;
            }

  input[type='checkbox']:checked:after {
            content: '✔';
            color: white;
            background-color: green !important;
            font-size: 16px;
            margin-top: 3px;
        }

    .popupspan {
        font-size: 11px;
        padding-right: 5px;
        padding-left: 5px;
        font-weight: 500;
    }

    #rzp-paymentresponse {
        display: none;
    }

    .tooltip-wrapper {
        display: inline-block; /* display: block works as well */
        
    }
   .tooltip-wrapper .showsubscribed {
            /* don't let button block mouse events from reaching wrapper */
            pointer-events: none;
     }

    .tooltip-wrapper.disabled {
            /* OPTIONAL pointer-events setting above blocks cursor setting, so set it here */
            cursor: not-allowed;
