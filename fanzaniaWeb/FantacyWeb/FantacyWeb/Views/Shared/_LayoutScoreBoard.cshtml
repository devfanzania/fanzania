<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>fanzania</title>
    <link rel="icon" href="~/Assets/Icon/fanzania-icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css/bootstrap.css" rel="stylesheet" />

    <link href="~/css/style.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link href="~/css/responsive.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard-new.css">
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/css/home-style.css" rel="stylesheet" />

    <script src="~/JS/jquery.js"></script>

</head>
<body class="theme-red">
    <div class="page-wrapper">
        <!-- Main Header / Style One-->
        <header class="main-header header-style-one">

            <!--Header-Main Box-->
            <div class="header-mainbox">
                <div class="container-fluid ptn pbn">
                    <div class="clearfix">
                        <div class="pull-left">
                            <div class="logo"> <a href="~/Home/Index"><img src="~/images/logo-icon.png" alt=""></a> </div>
                        </div>
                        <div class="outer-box clearfix">
                            <!-- Main Menu -->
                            <nav class="main-menu logo-outer">
                               
                                <div id="menu" class="navbar-collapse collapse clearfix">
                                    <ul class="navigation clearfix">
                                        <li>
                                            <a class="current_menu" href="#" tooltip="Refresh Scoreboard" onclick="RefreshScore()"><span class="fa fa-refresh"></span></a>
                                        </li>
                                    </ul>
                                </div>
                            </nav>
                            <!-- Main Menu End-->
                        </div>
                    </div>
                </div>
            </div>
            <!--Header Main Box End-->
        </header>
        <!--End Main Header -->
        @RenderBody()

    </div>
    <div class="scroll-to-top scroll-to-target" data-target=".main-header"><span class="fa fa-long-arrow-up"></span></div>

    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/JS/dashboard-script.js" type="text/javascript"></script>
    <script src="~/Scripts/grid-1.9.13.js"></script>
    <script src="~/JS/jquery.multiselect.js"></script>
    <script src="~/Scripts/Toastr_Config.js"></script>
    <script src="~/Scripts/toastr.js"></script>
   
</body>


</html>
