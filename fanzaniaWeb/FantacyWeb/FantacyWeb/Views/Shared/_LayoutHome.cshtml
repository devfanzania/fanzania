                success: function (data) {
                    //console.log(data);
                },
                error: function (req, status, error) {
                    return false;
                }
            });

        }, 270000);

    });
    function getLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(showPosition);
        }
        else { x.innerHTML = "Geolocation is not supported by this browser."; }
    }

    function showPosition(position) {
        lat = position.coords.latitude;
        lang = position.coords.longitude;

        window.localStorage.setItem("latt", lat);
        window.localStorage.setItem("langt", lang);
       // console.log(lat);       //return lat,long;
      //  codeLatLng(lat, lang);
    }
    function codeLatLng() {

      //  var GEOCODING = 'https://maps.googleapis.com/maps/api/geocode/json?latlng=' + lat + '%2C' + lang + '&language=en';
        var GEOCODING = 'https://maps.googleapis.com/maps/api/geocode/json?latlng=' + lat + '%2C' + lang + '&language=en';

        $.getJSON(GEOCODING).done(function (location) {
            console.log(location)
        })


    }

    function error(err) {
        console.log(err)
    }

    function SaveLogin() {
        Session_UserId = @Session["UserId"].ToString();
        var pData = { UserId: Session_UserId, LoginPreference: 'match'};
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/Dashboard/SaveloginPreference',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
               // console.log(data);
               // return;
                if (data.status == 'success') {
                    location.href = '/DailyGame/HomeD';
                  //  GetNotificationCount();
                    //.hide("slide", { direction: "left" }, 1000);
                    // $("#li_" + id).hide("slide", { direction: "left" }, 400, function () {

                  //  GetNotifications();
                }
                location.href = '/DailyGame/HomeD';

            },
            error: function (req, status, error) {
                toastr_warning("Opps! something went wrong. Try reload this page.");
                return false;
            }
        });
    }
    function showplayer() {
        $('#shareModal11').modal('show');
        return

        // console.log(pData);
        // return;


    }
    $(document).on("click", ".socialsharepopup", function (e) {
        e.preventDefault();
        $(".whatsapp_share").attr("href", '');
        $('.facebook_share').attr("href", '');
        $('.twitter_share').attr("href", '');
        $('.email').attr("href", '');
        var facebook = $(this).data("facebook");
        var whatsapp = $(this).data("whatsapp");
        var twitter = $(this).data("twitter");
        var email = $(this).data("email");
        $(".whatsapp_share").attr("href", whatsapp);
        $('.facebook_share').attr("href", facebook);
        $('.twitter_share').attr("href", twitter);
        $('.email_share').attr("href", email);
        $("#shareModal11").modal();
        //console.log("clicked");
    });
</script>
