@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}


<section class="inner-wrap">
    <div class="container">
        <div class="dashboardProfile">
            <div class="row">
                <div class="col-md-12 text-center"> <h3 class="profile-header">Change Password</h3></div>

                <div class="col-md-2"></div>
                <div class="col-md-8">

                    <div class="col-sm-10 col-sm-offset-1 form-box">

                        <div class="form-bottom-profile">

                            <div class="form-group">
                                <input type="password" id="new_Pass" class="form-control" placeholder="Enter new password" />
                                <label class="Labelregister">Minimum 8 characters</label>
                            </div>

                            <div class="form-group">
                                <input type="password" id="new_Rpass" class="form-control" placeholder="Re-enter password" />
                                <label class="Labelregister">Minimum 8 characters</label>
                            </div>

                            <div class="form-group">
                                <span class="field-validation-error">@ViewBag.Message</span>
                            </div>
                            <div class="form-group text-center">
                                <button id="btnSave" type="submit" class="btn-e Changepass" onclick="UpdatePass()" ;>Update</button>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-md-2"></div>
            </div>
        </div>
    </div>
</section>
<script>

    function UpdatePass() {
        
        var pass = $('#new_Pass').val();
        var rpass = $('#new_Rpass').val();
        if (pass.length < 8) {
            alert('Minimum 8 characters');
        } else {
            if (pass == rpass) {
                var uurl = '/Profile/UpdatePassword';
                var pData = { Password: pass };
                var jsonData = JSON.stringify(pData);
                $.ajax({
                    url: uurl,
                    type: 'POST',
                    data: jsonData,
                    dataType: 'json',
                    async: true,
                    cache: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (data) {
                        
                        if (data.status == 'success') {
                            
                            alert(data.statusMessage);
                            location.href = '/Dashboard/Index';
                        }
                    },
                    error: function (req, status, error) {
                        alert('Opps! something went wrong. Try reload this page.!');
                        return false;
                    }
                });
            }
            else {
                alert('Password not match.');
            }
        }
    }

</script>

