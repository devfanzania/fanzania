    function FetchWalletInfo() {
        $('#spinnerContainer').show();
        var uurl = '/Profile/FetchWalletInfo';

        $.ajax({
            url: uurl,
            type: 'POST',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.length > 0) {
                    $('#memberType').html(data[0].UserTier);
                    if (data[0].UserTier == 'BRONZE') {
                        $('#div_bronze').removeClass('m-box');
                        $('#div_bronze').addClass('m-box-active');
                        $('#div_bronze_Text').html('NEVER EXPIRES');
                    } else if (data[0].UserTier == 'SILVER') {
                        $('#div_silver').removeClass('m-box');
                        $('#div_silver').addClass('m-box-active');
                        $('#div_silver_Text').html('EXPIRES ' + data[0].TierExpiryDate);
                    } else if (data[0].UserTier == 'GOLD') {
                        $('#div_gold').removeClass('m-box');
                        $('#div_gold').addClass('m-box-active');
                        $('#div_gold_Text').html('EXPIRES ' + data[0].TierExpiryDate);
                    } else {
                        $('#div_platinum').removeClass('m-box');
                        $('#div_platinum').addClass('m-box-active');
                        $('#div_platinum_Text').html('EXPIRES ' + data[0].TierExpiryDate);
                    }
                    $('#tierPoint').html(data[0].WalletPoints + ' tier points');
                    $('#matchPts').html(data[0].MatchContestTotal + ' PTS');
                    $('#tourPts').html(data[0].TournamentTotal + ' PTS');
                    $('#memshipFrom').html(data[0].SignUpDate);
                    $('#recalculateTime').html(data[0].TierStartDate);
                    if (data[0].RetainTier != null && data[0].RetainTierByPoints != null) {
                        $('#RetainType').html('RETAIN ' + data[0].RetainTier + ' TIER');
                        $('#RetainPoint').html(data[0].RetainTierByPoints + ' PTS');
                        $('#RetainDate').html(data[0].RetainTierByDate);
                        $('#RetainType_H').show();
                        $('#RetainType_P').show();
                    }
                    else {
                        $('#RetainType_H').hide();
                        $('#RetainType_P').hide();
                    }
                    if (data[0].AttainTier != null && data[0].AttainTierByPoints != null) {
                        $('#AttainType').html('ATTAIN ' + data[0].AttainTier + ' TIER');
                        $('#AttainPoint').html(data[0].AttainTierByPoints + ' PTS');
                        $('#AttainDate').html(data[0].AttainTierByDate);
                        $('#AttainType_H').show();
                        $('#AttainType_P').show();
                    } else {
                        $('#AttainType_H').hide();
                        $('#AttainType_P').hide();
                    }

                }

                $('#spinnerContainer').hide();
            },
            error: function (req, status, error) {
                $('#spinnerContainer').hide();
                toastr_warning("Opps! something went wrong. Try reload this page.");
                return false;
            }
        });
    }

    function FetchRewardsInfo() {
        $('#spinnerContainer').show();
        var uurl = '/Profile/FetchTotalRewards';

        $.ajax({
            url: uurl,
            type: 'POST',
            async: false,
            cache: false,
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.length > 0) {
                    var div = '';
                    $.each(data, function (index, value) {
                        if (index == 0) {
                            $('#rewards').html('INR ' + value.TotalRewardAmount);
                        }
                        div += '<tr><td class="bundle">' + value.RewardType + '</td>';
                        div += '<td>' + ChageDatFormat((value.RewardDate).split('T')[0]) + '</td>';
                        div += '<td> INR ' + value.RewardAmount + '</td>';
                        div += '<td>' + value.Details + '</td></tr>';
                    });
                    $('#table-reward-breakup').html(div);
                    $('.breakdown-btn').prop('disabled', false);
                }
                else {
                    $('#rewards').html('INR 0');
                    $('.breakdown-btn').prop('disabled', true);
                }

                $('#spinnerContainer').hide();
            },
            error: function (req, status, error) {
                $('#spinnerContainer').hide();
                toastr_warning("Opps! something went wrong. Try reload this page.");
                return false;
            }
        });
    }


