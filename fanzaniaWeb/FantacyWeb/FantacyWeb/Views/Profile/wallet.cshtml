    function transferfunds() {
        Session_UserId = @Session["UserId"].ToString();
        var amount = $('#amount').val();



        var pattern = /^(-?)\d+$/;
        var result = pattern.test(amount);
            if (result != true) {
                // Do something...
                toastr_error("enter a valid amount ");
                return;
            }

        var TotalOutstandingAmount = $('#TotalOutstandingAmount').val();
        var MinAmountToWithDraw = $('#MinAmountToWithDraw').val();

        // if (Number(amount) == "" ) {
        // toastr_error("Please Enter amount");
        // return false;

        if (Number(amount) <= Number(TotalOutstandingAmount) && Number(amount) >= Number(MinAmountToWithDraw)) {
            $('#ewithdraw').hide();
            $('#dwithdraw').show();
            $('#showmessage').show();

            var uurl = '/Profile/transferfunds/';
            var pData = { UserId: Session_UserId, amount: amount };
            var jsonData = JSON.stringify(pData);
            $.ajax({
                url: uurl,
                type: 'POST',
                data: jsonData,
                dataType: 'json',
                async: true,
                cache: false,
                contentType: "application/json; charset=utf-8",

                success: function (data) {
                 // console.log(data);
                    if (data.status =='success') {
                        FetchWalletInfo();
                        FetchRewardsInfo();
                        FetchClaimInfo();
                        fetchbankdetails();
                        $('#amount').val('');
                        toastr_success(data.statusMessage);
                        $('#ewithdraw').show();
                        $('#dwithdraw').hide();
                        $('#showmessage').hide();
                        $('.bs-example-modal-lgwallet').modal('hide');
                    } else if (data.status == 'fail') {
                        toastr_error(data.statusMessage);
                        FetchWalletInfo();
                        FetchRewardsInfo();
                        FetchClaimInfo();
                        fetchbankdetails();
                        $('#amount').val('');
                       // toastr_success(data.statusMessage);
                        $('#ewithdraw').show();
                        $('#dwithdraw').hide();
                        $('#showmessage').hide();
                        $('.bs-example-modal-lgwallet').modal('hide');

                    }
                    //else {
                       // $('#ewithdraw').show();
                       // $('#dwithdraw').hide();
                      //  $('#showmessage').hide();
                      //  toastr_error(data.statusMessage);
                      //  return;
                  //  }
                },
                error: function (req, status, error) {
                    //$('#spinnerContainer').hide();
                    // toastr_warning("Unable to connect server for delete tournament!");
                    return false;
                }
            });

        } else {
            toastr_error("enter a valid amount");
            return false;
        }




    }

