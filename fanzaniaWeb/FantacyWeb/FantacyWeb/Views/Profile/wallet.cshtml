    function ChageDatFormat(date) {
        var arr = date.split('-');
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
        var i = 1;
        var mon = '';
        for (i = 1; i <= months.length; i++) {
            if (i == parseInt(arr[1])) {
                mon = months[i - 1];
                break;
            }
        }
        var formatddate = arr[2] + ' ' + mon + ' ' + arr[0];
        return formatddate;
    }

