    function ExportToExcel() {
        var Tid = $('#TournamentId').val();
        var pData = { TournamentId: Tid };
        //$('#spinnerContainer').show();
        $.ajax({
            url: '/AdminTour/ExportPointList',
            type: 'GET',
            data: pData,
            dataType: 'json',
            async: true,
            success: function (data) {

                //alert('hi');
                //alert(data);
                $('#tblExcel').empty();
                var trHead = "<thead><tr><th>TournamentStage</th><th>RunScored</th><th>FourBonus</th><th>SixBonus</th><th>HalfCenturyBonus</th><th>CenturyBonus</th><th>DismissalDuck</th><th>MinBall4SR</th><th>StrikeRateBelow50</th><th>StrikeRate50To60</th>";
                trHead += "<th>StrikeRate60To70</th><th>StrikeRate110To150</th><th>StrikeRateUp150</th><th>WicketTaken</th><th>Wicket3UpBonus</th><th>Wicket5UpBonus</th><th>MaidenOver</th><th>Hattrick</th><th>MinOver4ER</th><th>EconomyBelow4</th><th>Economy4To5</th>";
                trHead += "<th>Economy5To6</th><th>Economy9To11</th><th>EconomyUp11</th><th>Captain</th><th>ViceCaptain</th><th>CatchTaken</th><th>Stumping</th><th>RunOutDirect</th><th>RunOutThrower</th><th>RunOutCatcher</th><th>Nitro</th><th>MoM</th></tr></thead>";
                var tBody = trHead + "<tbody>";

                $.each(data, function (index, value) {

                    tBody += "<tr><td>" + value.TournamentStage + "</td><td>" + value.RunScored + "</td><td>" + value.FourBonus + "</td><td>" + value.SixBonus + "</td><td>" + value.HalfCenturyBonus + "</td><td>" + value.CenturyBonus + "</td><td>" + value.DismissalDuck + "</td><td>" + value.MinBall4SR + "</td><td>" + value.StrikeRateBelow50 + "</td><td>" + value.StrikeRate50To60 + "</td><td>" + value.StrikeRate60To70 + "</td>";
                    tBody += "<td>" + value.StrikeRate110To150 + "</td><td>" + value.StrikeRateUp150 + "</td><td>" + value.WicketTaken + "</td><td>" + value.Wicket3UpBonus + "</td><td>" + value.Wicket5UpBonus + "</td><td>" + value.MaidenOver + "</td><td>" + value.Hattrick + "</td><td>" + value.MinOver4ER + "</td><td>" + value.EconomyBelow4 + "</td><td>" + value.Economy4To5 + "</td><td>" + value.Economy5To6 + "</td><td>" + value.Economy9To11 + "</td>";
                    tBody += "<td>" + value.EconomyUp11 + "</td><td>" + value.Captain + "</td><td>" + value.ViceCaptain + "</td><td>" + value.CatchTaken + "</td><td>" + value.Stumping + "</td><td>" + value.RunOutDirect + "</td><td>" + value.RunOutThrower + "</td><td>" + value.RunOutCatcher + "</td><td>" + value.Nitro + "</td><td>" + value.MoM + "</td></tr>";

                });
                tBody += "</tbody>";

                $('#tblExcel').append(tBody);
                var FileName = "PointList_" + new Date().toLocaleString();
                $(".table2excel").table2excel({
                    //exclude: ".noExl",
                    name: "Excel Document Name",
                    filename: FileName
                });
                //$('#spinnerContainer').hide();
            },
            error: function (req, status, error) {
                alert('Not able to export excel, because system allow us for 10000 rows of data download at a time.');
            }
        }).done(function () {
        });;
    }

