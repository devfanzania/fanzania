
@{
    ViewBag.Title = "TeamEdit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@Html.Hidden("TournamentId")
@Html.Hidden("TeamId")
<div class="forms-main">
    <div class="forms-inner">
        <div class="set-1">
            <div class="graph-2 general">
                <div class="row">
                    <div class="col-md-6">
                        <h3 class="inner-tittle text-left">Team Edit</h3>
                    </div>

                    <div class="text-right pull-right col-md-6">
                        <a href="/AdminTeam/Index" class="back-team-btn"><i class="fa fa-arrow-left"></i>Back</a>
                    </div>
                </div>
                <div class="grid-1">
                    <div class="form-body">
                        @*<form class="form-horizontal">*@
                        <div class="row form-group">
                            <div class="col-md-3">
                                <label for="txt_TeamId" class="control-label">Team Id</label>
                                <input type="text" class="form-control1" id="txt_TeamId" readonly="readonly" placeholder="">
                            </div>
                            <div class="col-md-3">
                                <label for="txt_TeamName" class="control-label">Team Name</label>
                                <input type="text" class="form-control1" id="txt_TeamName" placeholder="">
                            </div>
                            <div class="col-md-3">
                                <label for="ddl_TeamShortName" class="control-label">Team Short Name</label>
                                <input type="text" class="form-control1" id="ddl_TeamShortName" placeholder="">
                            </div>
                            <div class="col-md-3">
                                <label for="txt_ImageName" class="control-label">Image Name</label>
                                <input type="text" class="form-control1" id="txt_ImageName" placeholder="">
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-3">
                                <label for="txt_TeamDesc" class="control-label">Team Description</label>
                                <input type="text" class="form-control1" id="txt_TeamDesc" placeholder="">
                            </div>
                            @*<div class="col-md-3">
                                <label for="txt_RapidTeamId" class="control-label">Rapid Team Id</label>
                                <input type="text" class="form-control1" id="txt_RapidTeamId" placeholder="">
                            </div>*@
                            <div class="col-md-3 text-center">
                                <label for="TeamKey" class="control-label">TeamKey</label>
                                <input type="text" class="form-control1" id="TeamKey" placeholder="">
                            </div>
                            @*<div class="col-md-3 text-right">
            <label class="control-label">&nbsp;</label>
            <button id="btn_Reset_Points" class="btn btn-info" onclick="ResetPoints()" ;> Reset Points</button>
        </div>*@
                            <div class="col-md-3 text-right">
                                <label class="control-label">&nbsp;</label>
                                <button id="btn_Update_Details" class="btn btn-info" onclick="UpdateTeam()" ;> Update Details</button>
                            </div>
                        </div>


                        @*</form>*@
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        var ptid = '@Session["T_ptid"].ToString()';
        var tid = '@Session["T_tid"].ToString()';
        sessionStorage.setItem("TeamTournamentId", tid);
        $('#TournamentId').val(tid);
        $('#TeamId').val(ptid);

        GetTeamDetails();

    });

    function GetTeamDetails() {
        var Tid = $('#TournamentId').val();
        var ptid = $('#TeamId').val();

        /// $('#spinnerContainer').show();
        var pData = { TournamentId: Tid, ParticipationTeamId: ptid };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminTeam/GetTeamForUpdate',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: false,
            // cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
                console.log(data);
                $('#txt_TeamId').val(data[0]["ParticipationTeamId"]);
                $('#txt_TeamName').val(data[0]["ParticipationTeamName"]);
                $('#ddl_TeamShortName').val(data[0]["TeamShortName"]);
                $('#txt_TeamDesc').val(data[0]["TeamDescription"]);
                $('#txt_ImageName').val(data[0]["TeamImage"]);
                $('#txt_RapidTeamId').val(data[0]["RapidTeamId"]);
                $('#TeamKey').val(data[0]["TeamKey"]);
            },
            error: function (req, status, error) {
                var str = "Req:" + req + ", Status:" + status + ", Error:" + error;
                alert(JSON.stringify(req));
                // $('#spinnerContainer').hide();
            }
        })
    }

    function UpdateTeam() {
        var Tid = $('#TournamentId').val();
        var ptid = $('#TeamId').val();
        var txt_TeamName = $('#txt_TeamName').val();
        var ddl_TeamShortName = $('#ddl_TeamShortName').val();
        var txt_TeamDes = $('#txt_TeamDesc').val();
        var txt_ImageName = $('#txt_ImageName').val();
        var txt_RapidTeamId = $('#txt_RapidTeamId').val();
        var TeamKey = $('#TeamKey').val();
        if (txt_TeamName == '') {
            alert('Please enter team name');
            return;
        }
        if (ddl_TeamShortName == '') {
            alert('Please enter team short name');
            return;
        }
        if (txt_TeamDes == '') {
            alert('Please enter team description');
            return;
        }
        if (txt_RapidTeamId == '') {
            alert('Please enter rapid team id');
            return;
        }
        /// $('#spinnerContainer').show();

        var pData = { TournamentId: Tid, ParticipationTeamId: ptid, ParticipationTeamName: txt_TeamName, TeamDescription: txt_TeamDes, TeamShortName: ddl_TeamShortName, TeamImage: txt_ImageName, RapidTeamId: txt_RapidTeamId, TeamKey:TeamKey };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/AdminTeam/UpdateTeam',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: false,
            // cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {

                if (data.status == "success") {

                    alert('Data updated successfuly!');
                    location.href = '/AdminTeam/Index';
                }
                else {
                    alert(data.statusMessage);
                }
            },
            error: function (req, status, error) {
                var str = "Req:" + req + ", Status:" + status + ", Error:" + error;
                alert(JSON.stringify(req));
                // $('#spinnerContainer').hide();
            }
        })
    }


</script>

