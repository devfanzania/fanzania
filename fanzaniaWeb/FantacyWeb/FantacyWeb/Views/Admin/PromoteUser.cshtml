<script>
    function updateuserpoints() {
        var MatchId = $('#MatchIdd').val();
        if (MatchId == '') {
            alert('Please enter some MatchId');
            return;
        }
        var PlayerId = $('#PlayerId').val();
        if (PlayerId == '') {
            alert('Please enter some PlayerId');
            return;
        }
        var BattingPoints = $('#BattingPoints').val();
        if (BattingPoints == '') {
            alert('Please enter some BattingPoints');
            return;
        }
        var BowlingPoints = $('#BowlingPoints').val();
        if (BowlingPoints == '') {
            alert('Please enter some BowlingPoints');
            return;
        }
        var FieldingPoints = $('#FieldingPoints').val();
        if (FieldingPoints == '') {
            alert('Please enter some FieldingPoints');
            return;
        }
        //$('#spinnerContainer').show();
        var uurl = '/Admin/adminupdateuserpoints';
        var pData = { MatchId: MatchId, PlayerId: PlayerId, BattingPoints: BattingPoints, BowlingPoints: BowlingPoints, FieldingPoints: FieldingPoints};
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: uurl,
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
                console.log(data);
                if (data.status = 'Success') {
                    alert(data.statusMessage);
                 //   $('#txt_funfact').val('');
                    //$('#spinnerContainer').hide();
                }
            },
            error: function (req, status, error) {
                //$('#spinnerContainer').hide();
                toastr_warning("Unable to connect server!");
                return false;
            }
        });
    }
    function SendNotification() {
        var title_notification = $('#title_notification').val();
        if (title_notification == '') {
            alert('Please enter title');
            return;
        }
        var txt_Notification = $('#txt_Notification').val();
        if (txt_Notification == '') {
            alert('Please enter message');
            return;
        }
      
        //$('#spinnerContainer').show();
        var uurl = '/Admin/SendNotification';
        var pData = { Title: title_notification ,Message: txt_Notification };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: uurl,
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
                if (data.status = 'Success') {
                    alert('Notification Send successfully');
                    $('#txt_Notification').val('');
                    $('#title_notification').val('');
                    //$('#spinnerContainer').hide();
                }
            },
            error: function (req, status, error) {
                //$('#spinnerContainer').hide();
                toastr_warning("Unable to connect server!");
                return false;
            }
        });
    }

    function PromoteUser() {
        var email = $('#txt_UserEmail').val();
        if (email == '') {
            alert('Please enter email id');
            return;
        }
      
        //$('#spinnerContainer').show();
        var uurl = '/Admin/UpdateUser';
        var pData = { Email: email};
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: uurl,
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
                if (data.status = 'Success') {
                    alert('Promoted successfully');
                    $('#txt_UserEmail').val('');
                    //$('#spinnerContainer').hide();
                }
            },
            error: function (req, status, error) {
                //$('#spinnerContainer').hide();
                toastr_warning("Unable to connect server!");
                return false;
            }
        });
    }
    function PromoteUserLeague() {
