     function updateSubscriptionDetails(){
         var email = $('#email').val();
         if (email == '') {
             alert('Please enter  email');
             return;
         }
         var SubscriptionType = $('#SubscriptionType').val();
         if (SubscriptionType == '') {
             alert('Please enter  SubscriptionType');
             return;
         }
        
         var Amount = $('#Amount').val();
         if (Amount == '') {
             alert('Please enter Amount');
             return;
         }
         var pData = { Email: email, SubscriptionTier: SubscriptionType, receipt: "manual", amount: Amount };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/Admin/UpdateSubscriptionDetails',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",
          
            success: function (data) {
             //   alert('test');
              //  console.log("update subscription derails",data);
              // return;
              if (data.status == 'success') {
                  $('#email').val('');
                  $('#SubscriptionType').val('');
                  $('#Amount').val('');
                  alert(data.statusMessage);
              }

            },
            error: function (req, status, error) {
                alert("Opps! something went wrong. Try reload this page.");
                return false;
            }
        });
    }
    function getSubscriptiondetails() {
        var email = $('#email').val();
        if (email == '') {
            alert('Please enter  email');
            return;
        }
        var pData = { Email: email, UserId: 0 };
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/Admin/GetSubscriptionDetails',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
                
                if (data.status == 'success') {
                    console.log(data.data.CurrentSubscriptionTier);
                    $('#SubscriptionType').val(data.data.CurrentSubscriptionTier);
                 
                }

            },
