    }
    function updateSubscriptionDetails(tire, amount, receipt, currency) {
      
        Session_UserId = @Session["UserId"].ToString();
        tire = tire.substr(tire.length - 1);
        amt = (amount / 100);
        //alert(amt);
       // alert(receipt);
        var pData = { UserId: Session_UserId, SubscriptionTier: tire, receipt: receipt, amount: amt, Currency: currency};

        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/Payment/UpdateSubscriptionDetails',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",
          
