<script>
    $(document).ready(function () {
        GetSubscriptionDetails();
    });
    let getsubdetails;
    $("#selectcurrancy").change(function () {
        //console.log("getde",getsubdetails);
        var outof = '';
        var outof1 = '';
        var outof2 = '';
        var outof3 = '';
        if ($('#selectcurrancy').val() == 'USD') {
          //  alert(getsubdetails.LivePackageAmount_USD);
            outof1 += ' <span>USD</span> <span>NA</span>';
            $("#SubTier1").html(outof1);
            outof2 += '<span>USD</span> <span>' + getsubdetails.LivePackageAmount_USD + '</span>';
            $("#SubTier2").html(outof2);

            outof3 += ' <span>USD</span> <span>NA</span>';
            $("#SubTier3").html(outof3);
            outof += '<span>' + getsubdetails.SubTierFree + '</span>';
            $("#SubTierFree").html(outof);
            $('#paybtn1').hide();
            $('#dpaybtn1').show();
            $('#paybtn3').hide();
            $('#dpaybtn3').show();
            document.getElementById("amountSubTier1").value = getsubdetails.PrizePackageAmount_USD;
            document.getElementById("amountSubTier2").value = getsubdetails.LivePackageAmount_USD;
            document.getElementById("amountSubTier3").value = getsubdetails.FullPackageAmount_USD;

        }
        else if ($('#selectcurrancy').val() == 'INR') {
            outof1 += '<span>INR</span> <span>' + getsubdetails.PrizePackageAmount + '</span>';
            $("#SubTier1").html(outof1);
            outof2 += '<span>INR</span> <span>' + getsubdetails.LivePackageAmount + '</span>';
            $("#SubTier2").html(outof2);

            outof3 += '<span>INR</span> <span>' + getsubdetails.FullPackageAmount + '</span>';
            $("#SubTier3").html(outof3);
            $('#paybtn1').show();
            $('#dpaybtn1').hide();
            $('#paybtn3').show();
            $('#dpaybtn3').hide();
            outof += '<span>' + getsubdetails.SubTierFree + '</span>';
            $("#SubTierFree").html(outof);
            document.getElementById("amountSubTier1").value = getsubdetails.LivePackageAmount;
            document.getElementById("amountSubTier2").value = getsubdetails.PrizePackageAmount;
            document.getElementById("amountSubTier3").value = getsubdetails.FullPackageAmount;


        } else if ($('#selectcurrancy').val() == 'GBP') {
            outof1 += ' <span>GBP</span> <span>NA</span>';
            $("#SubTier1").html(outof1);
            outof2 += '<span>GBP</span> <span>' + getsubdetails.LivePackageAmount_GBP + '</span>';
            $("#SubTier2").html(outof2);

            outof3 += '<span>GBP</span> <span>NA</span>';
            $("#SubTier3").html(outof3);
            outof += '<span>' + getsubdetails.SubTierFree + '</span>';
            $("#SubTierFree").html(outof);
            $('#paybtn1').hide();
            $('#dpaybtn1').show();
            $('#paybtn3').hide();
            $('#dpaybtn3').show();
            document.getElementById("amountSubTier1").value = getsubdetails.LivePackageAmount_GBP;
            document.getElementById("amountSubTier2").value = getsubdetails.PrizePackageAmount_GBP;
            document.getElementById("amountSubTier3").value = getsubdetails.FullPackageAmount_GBP;

        }
    });
    function GetSubscriptionDetails() {
        Session_UserId = @Session["UserId"].ToString();
        var pData = { UserId: Session_UserId};
        var jsonData = JSON.stringify(pData);
        $.ajax({
            url: '/Payment/GetSubscriptionDetails',
            type: 'POST',
            data: jsonData,
            dataType: 'json',
            async: true,
            cache: false,
            contentType: "application/json; charset=utf-8",

            success: function (data) {
                getsubdetails = data;
               console.log(data);
            //   return;
              //  if (data.status == 'success') {
                var outof = '';
                var outof1 = '';
                var outof2 = '';
                var outof3 = '';
              //  var CurrentSubscriptionTier = '';
               
                if (data.SubTier1PayEnable.toUpperCase() == 'TRUE') {
                    $('#paybtn1').show();
                    $('#dpaybtn1').hide();
                }
                if (data.SubTier2PayEnable.toUpperCase() == 'TRUE') {
                    $('#paybtn2').show();
                    $('#dpaybtn2').hide();
                }
                if (data.SubTier3PayEnable.toUpperCase() == 'TRUE') {
                    $('#paybtn3').show();
                    $('#dpaybtn3').hide();

                }
                if (data.SubTier1PayEnable.toUpperCase() == 'FALSE') {
                    $('#paybtn1').hide();
                    $('#dpaybtn1').show();
                }
                if (data.SubTier2PayEnable.toUpperCase() == 'FALSE') {
                    $('#paybtn2').hide();
                    $('#dpaybtn2').show();
                }
                if (data.SubTier3PayEnable.toUpperCase() == 'FALSE') {
                   $('#paybtn3').hide();
                    $('#dpaybtn3').show();

                }

                if (data.CurrentSubscriptionTier == 3) {
                    $('#CurrentSubscriptionTier3').show();

                }
             
                if (data.CurrentSubscriptionTier == 2) {
                    $('#CurrentSubscriptionTier2').show();
                  
                }
                if (data.CurrentSubscriptionTier == 1) {
                    $('#CurrentSubscriptionTier1').show();
               
                }
                if (data.CurrentSubscriptionTier == 0) {
                    $('#CurrentSubscriptionTier0').show();
             
                }
            

                outof1 += '<span>INR</span> <span>' + data.PrizePackageAmount + '</span>';
                $("#SubTier1").html(outof1);
                outof2 += '<span>INR</span> <span>' + data.LivePackageAmount + '</span>';
                $("#SubTier2").html(outof2);

                outof3 += '<span>INR</span> <span>' + data.FullPackageAmount + '</span>';
                $("#SubTier3").html(outof3);
                outof += '<span>' + data.SubTierFree + '</span>';
                $("#SubTierFree").html(outof);
                document.getElementById("amountSubTier1").value = data.PrizePackageAmount;
                document.getElementById("amountSubTier2").value = data.LivePackageAmount;
                document.getElementById("amountSubTier3").value = data.FullPackageAmount;
              
              //  arr1 = data.SubTier1.split(' ');
              //  strA = arr1[1];    
              //  document.getElementById("amountSubTier1").value = strA;

              //  arr2 = data.SubTier2.split(' ');
               // strB = arr2[1];
              //  document.getElementById("amountSubTier2").value = strB;

               // arr3 = data.SubTier3.split(' ');
             //   strC = arr3[1];
              //  document.getElementById("amountSubTier3").value = strC;
               // document.getElementById("myText").value =data.SubTier1;
                document.getElementById('details').innerHTML = data.Details;
               // document.getElementById('details1').innerHTML = data.Details;
                //  }

            },
            error: function (req, status, error) {
                toastr_warning("Opps! something went wrong. Try reload this page.");
                return false;
            }
        });
    }

    function payment(UserName, Email, PhoneNumber, tire) {
        if ($('#selectcurrancy').val() == 'USD') {

            currency = 'USD';
        } else if ($('#selectcurrancy').val() == 'GBP') {
            currency = 'GBP';
        }
        else if ($('#selectcurrancy').val() == 'INR') {
            currency = 'INR';
        }
        if (tire == 'SubTier1') {
            amount = document.getElementById('amountSubTier1').value;
            description = 'PRIZE ELIGIBILITY Package | ' + currency + ' ' + amount +' Gives you eligibility to win prizes in both Tournament Mode and Match Contests.Applicable for IPL 2021 only.Excludes Live Scoring'
        } else if (tire == 'SubTier2') {
            amount = document.getElementById('amountSubTier2').value;
            description = 'LIVE SCORE Package | ' + currency + ' ' + amount +' Gives you access to Live Score feature in both Tournament Mode and Match Contests.Applicable for IPL 2021 only.Prize Eligibility Excluded.'
        } else if (tire == 'SubTier3'){
            amount = document.getElementById('amountSubTier3').value;
            description = 'PRIZE ELIGIBILITY and LIVE SCORE Package |' + currency +' ' + amount +' Gives you access to live score fetaure and eligibility to win prizes in both Tournament Mode and Match Contests. Applicable for IPL 2021 only.'
        }
      
      //  console.log(UserName, Email, PhoneNumber, amount)
