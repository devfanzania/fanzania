        </layout>
      </parameter>
      <parameter>
        <parameterName value="@apiName" />
        <dbType value="String" />
        <size value="500" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="apiName" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@fileName" />
        <dbType value="String" />
        <size value="256" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="fileName" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@loginUser" />
        <dbType value="String" />
        <size value="200" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="loginUser" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@hostName" />
        <dbType value="String" />
        <size value="100" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="hostName" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@transactionId" />
        <dbType value="String" />
        <size value="100" />
