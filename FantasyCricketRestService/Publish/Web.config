  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <compilation targetFramework="4.6.1" />
    <httpRuntime />
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
  <log4net>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="LogFileAppender" />
      <appender-ref ref="AdoNetAppender4Audit" />
      <appender-ref ref="AdoNetAppender4Exception" />
    </root>
    <logger name="Common.Logger.CommonLogger" additivity="false">
      <appender-ref ref="LogFileAppender" />
      <appender-ref ref="AdoNetAppender4Audit" />
    </logger>
    <logger name="ExceptionLogger" additivity="false">
      <appender-ref ref="LogFileAppender" />
      <appender-ref ref="AdoNetAppender4Exception" />
    </logger>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <bufferSize value="1" />
      <param name="File" value="C:\FantasyLogs\FantasyCricket.RestAPI.txt" />
      <param name="AppendToFile" value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="2MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <appender name="AdoNetAppender4Audit" type="log4net.Appender.AdoNetAppender">
      <bufferSize value="1" />
      <connectionType value="System.Data.SqlClient.SqlConnection, System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      <connectionString value="Data Source=fantasycricket.ccmegberpacg.ap-south-1.rds.amazonaws.com;Initial Catalog=FANTASYCRICKET;User Id=fcricketuser;Password=Fantasycri!cket;Application Name='FantasyCricket';" providerName="System.Data.SqlClient" />
      <commandText value="InsertAudit" />
      <commandType value="StoredProcedure" />
      <!--<commandText value="INSERT INTO [dbo].[Audit](EnvCode,ProductName,APIName,FileName,LoginUser,HostName,TransactionId,TransactionType,Status,Message,Payload,LogTimeStamp)  VALUES(@envCode,@productName,@apiName,@fileName,@loginUser,@hostName,@transactionId,@transactionType,@status,@message,@payload,GETDATE());" />-->
      <parameter>
        <parameterName value="@envCode" />
        <dbType value="String" />
        <size value="50" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="envCode" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@productName" />
        <dbType value="String" />
        <size value="50" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="productName" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@apiName" />
        <dbType value="String" />
        <size value="500" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="apiName" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@fileName" />
        <dbType value="String" />
        <size value="256" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="fileName" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@loginUser" />
        <dbType value="String" />
        <size value="200" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="loginUser" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@hostName" />
        <dbType value="String" />
        <size value="100" />
        <layout type="log4net.Layout.RawPropertyLayout">
