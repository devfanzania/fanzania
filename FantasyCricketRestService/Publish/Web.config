        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="transactionType" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@status" />
        <dbType value="String" />
        <size value="50" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="status" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@message" />
        <dbType value="String" />
        <size value="200" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="message" />
        </layout>
      </parameter>
      <parameter>
        <parameterName value="@payload" />
        <dbType value="String" />
        <size value="-1" />
        <layout type="log4net.Layout.RawPropertyLayout">
          <key value="payload" />
        </layout>
      </parameter>
    </appender>
    <appender name="AdoNetAppender4Exception" type="log4net.Appender.AdoNetAppender">
