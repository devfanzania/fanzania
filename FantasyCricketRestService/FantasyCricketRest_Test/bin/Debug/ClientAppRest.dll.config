<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
  <configSections>
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="LplEmsCoreSettings" type="LPL.EMS.Core.Configuration.LplEmsCoreSettings, LPL.EMS.Core" />
  </configSections>
  <!--
    Settings for EMS connectivity
    Note: Here are the physical names of the EMS server IPs. Each QA slice has a VIP for the EMS server
    as "tibcoemsqa.sdqa.lpl.com".  Prod has a VIP as "tibcoemsprod.ncprod.lpl.com"
    - Dev: txserarchapp02.sddev.lpl.com [actual - txserarchapp02.sddev.lpl.com] (Port: 7222)
    - DevInt: txtibemsdev11.sddev.lpl.com [actual - txtibemsdev11.sddev.lpl.com] (Port: 7122)
    - QA1: tibcoemsqa.sdqa.lpl.com [actual - txtibemsqa11.sdqa.lpl.com] (Port: 7122)
    - QA2: tibcoemsqa.sdqa.lpl.com [actual - txtibemsqa21.sdqa.lpl.com] (Port: 7122)
    - QA3: tibcoemsqa.sdqa.lpl.com [actual - txtibemsqa31.sdqa.lpl.com] (Port: 7122)
    - QA4: tibcoemsqa.sdqa.lpl.com [actual - txtibemsqa41.sdqa.lpl.com] (Port: 7122)
    - PROD: nctibemsprd01.ncprod.lpl.com (Port: 7122)
    - TRAIN: 172.30.32.48 [actual - TXTIBEMSTRN01] (Port: 7122)
   -->
  <LplEmsCoreSettings
      application_Name = "ClientAppRest"
      application_Identity = "ClientAppRest"
    
      emsQueues_Credentials_UserName = "admin"
      emsQueues_Credentials_Password = ""
    
      emsQueues_Defaults_MessagePriority = "4"
      emsQueues_Defaults_MessageReceiveTimeout = "60000"
      emsQueues_Defaults_MessageTimeToLive = "60000"
      
      emsQueues_Messages_ReservedPropertyName_HttpMethod = "httpMethod"
      emsQueues_Messages_ReservedPropertyName_HttpUri = "httpURI"
      emsQueues_Messages_ReservedPropertyName_SecurityToken = "securityToken"
      emsQueues_Messages_ReservedPropertyName_SourceSystem = "sourceSystem"
      emsQueues_Messages_ReservedPropertyName_Timestamp = "timestamp"
      emsQueues_Messages_ReservedPropertyName_TransactionID = "transactionID"
      
      servers_EmsUri = "tcp://txtibemsqa41.sdqa.lpl.com:7122"
  />
  <appSettings>
    <add key ="FirmID" value ="1"/>
    <add key="lpl:application:name" value="ClientAppRest" />
    <add key="lpl:services:auth:interfaces:legacy" value="tcp://vscapp.sd.lpl.com:5123/AuthTypeObject" />
    <add key="lpl:services:logging:legacy" value="tcp://localhost:8090/Logger" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="lpl:application:name" value="ClientAppRest" />
    <add key="lpl:cors:Enabled" value="true" />
    <add key="lpl:cors:AllowOrigins" value="*" />

    <!-- The following are set to true because this is a REST service that is running in the APP tier -->
    <add key="lpl:overrides:BypassAllAuthenticationChecks" value="true" />
    <add key="lpl:overrides:BypassAllXsrfChecks" value="true" />
    
    <add key="lpl:overrides:IncludeDetailedErrorsInJsonResponse" value="true" />
    <add key="lpl:overrides:DeveloperMode" value="true" />
    <add key="lpl:services:legacy:auth" value="tcp://vscapp.sd.lpl.com:5123/AuthTypeObject" />
    <add key="lpl:services:legacy:logger" value="tcp://localhost:8090/Logger" />
    <add key="lpl:services:rest:audit" value="http://localhost:1212/LogRest/api/audit/event" />
  </appSettings>
  <connectionStrings>
    <!--<add name="LPL.LPLCustomer" connectionString="Data Source=TXI1LPLSQLDEV01.sddev.lpl.com;Initial Catalog=LPLCUSTOMER;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="AXA.LPLCustomer" connectionString="Data Source=TXO1AXASQLDEV01.sddev.lpl.com;Initial Catalog=LPLCUSTOMER;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="LPL.BranchForms" connectionString="Data Source=TXI1LPLSQLDEV01.sddev.lpl.com;Initial Catalog=BranchForms;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="AXA.BranchForms" connectionString="Data Source=TXO1AXASQLDEV01.sddev.lpl.com;Initial Catalog=BranchForms;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="LPL.Transaction" connectionString="Data Source=TXI1LPLSQLDEV01.sddev.lpl.com;Initial Catalog=Transaction;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="AXA.Transaction" connectionString="Data Source=TXO1AXASQLDEV01.sddev.lpl.com;Initial Catalog=Transaction;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />-->
    <add name="LPL.LPLCustomer" connectionString="Data Source=BranchNetSQL1;Initial Catalog=LPLCUSTOMER;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="AXA.LPLCustomer" connectionString="Data Source=BranchNetSQL1;Initial Catalog=LPLCUSTOMER;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="LPL.BranchForms" connectionString="Data Source=BranchNetSQL1;Initial Catalog=BranchForms;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="AXA.BranchForms" connectionString="Data Source=BranchNetSQL1;Initial Catalog=BranchForms;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="LPL.Transaction" connectionString="Data Source=BranchNetSQL1;Initial Catalog=Transaction;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
    <add name="AXA.Transaction" connectionString="Data Source=BranchNetSQL1;Initial Catalog=Transaction;User Id=eam2000;Password=sceam;Application Name='ClientAppRest';" />
  </connectionStrings>
  <system.webServer>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <common>
    <logging>
      <factoryAdapter type="Common.Logging.Log4Net.Log4NetLoggerFactoryAdapter, Common.Logging.Log4net1211">
        <arg key="configType" value="INLINE" />
      </factoryAdapter>
    </logging>
  </common>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="DEBUG" />
        <levelMax value="FATAL" />
      </filter>
      <file value="C:\Temp\ClientAppRest.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] [%property{NDC}] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <appender name="DebugAppender" type="log4net.Appender.DebugAppender">
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="DEBUG" />
        <levelMax value="FATAL" />
      </filter>
      <immediateFlush value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="[%thread] %-5level - %message%newline" />
      </layout>
    </appender>
    <appender name="RemotedLogServiceAppender" type="LPL.Common.Logging.Client.Appenders.RemotedLogServiceAppender, LPL.Common.Logging.Client">
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="INFO" />
        <levelMax value="FATAL" />
        <levelMin value="DEBUG" />
      </filter>
      <ApplicationName value="ClientAppRest" />
      <ServiceUri value="tcp://localhost:8090/Logger" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
        <conversionPattern value="[%thread] [%property{NDC}] %message%newline" />
      </layout>
      <ApplicationName value="LPL.Common.Logging.Examples" />
    </appender>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingFileAppender" />
      <appender-ref disabled-ref="RemotedLogServiceAppender" />
      <appender-ref disabled-ref="DebugAppender" />
    </root>
  </log4net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Common.Logging" publicKeyToken="af08829b84f0328e" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.13.0" newVersion="1.2.13.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
    <authentication mode="None">
    </authentication>
    <customErrors mode="Off">
    </customErrors>
    <sessionState mode="InProc" timeout="30" cookieName="myapp" />
  </system.web>
</configuration>