<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <include
            android:id="@+id/inToolbar"
            layout="@layout/commontoolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <RelativeLayout
            android:id="@+id/rlSaveTeam"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inToolbar"
            app:layout_constraintVertical_bias="1.0"
            >

            <com.yorker.fanzania.customviews.CustomButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@color/colorRedNew"
                android:text="@string/text_saveteam"
                android:textAllCaps="true"
                android:textColor="@color/colorWhite"
                android:textSize="14sp"
                app:fontName="Montserrat_Regular" />

            <ProgressBar
                android:id="@+id/pBar"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerInParent="true"
                android:visibility="gone"
                />

        </RelativeLayout>

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
            android:id="@+id/tvSPlayers"
            android:layout_width="140dp"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/round_corner_teampreview"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="@string/text_teampreview"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inToolbar"
            app:layout_constraintVertical_bias="0.0" />

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratLight
            android:id="@+id/tvBudgetAmt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:text="131K"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toStartOf="@+id/tvSPlayers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inToolbar"
            app:layout_constraintVertical_bias="0.0" />

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratLight
            android:id="@+id/montserratLight4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/text_budgetleft"
            android:textColor="@color/colorRedText"
            android:textSize="12sp"
            android:textAllCaps="true"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toStartOf="@+id/tvSPlayers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBudgetAmt"
            app:layout_constraintVertical_bias="0.0" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:background="@color/colorBlack"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toStartOf="@+id/tvSPlayers"
            app:layout_constraintStart_toEndOf="@+id/montserratLight4"
            app:layout_constraintTop_toBottomOf="@+id/inToolbar"
            app:layout_constraintVertical_bias="0.0" />

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
            android:id="@+id/tvTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            tools:text="23m:3s"
            android:textColor="@color/colorText"
            android:textSize="10sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvSPlayers"
            app:layout_constraintTop_toBottomOf="@+id/inToolbar"
            app:layout_constraintVertical_bias="0.0" />


        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratLight
            android:id="@+id/montserratLight5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/text_startsin"
            android:textAllCaps="true"
            android:textColor="@color/colorRedText"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvSPlayers"
            app:layout_constraintTop_toBottomOf="@+id/tvTimeRemaining"
            app:layout_constraintVertical_bias="0.0" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:background="@color/colorBlack"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toStartOf="@+id/montserratLight5"
            app:layout_constraintStart_toEndOf="@+id/tvSPlayers"
            app:layout_constraintTop_toBottomOf="@+id/inToolbar"
            app:layout_constraintVertical_bias="0.0" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tbSort"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSPlayers"
            app:layout_constraintVertical_bias="0.0"
            app:tabBackground="@drawable/tab_player_selector"
            app:tabIndicatorColor="@null"
            app:tabMode="fixed"
            app:tabPaddingEnd="10dp"
            app:tabPaddingStart="10dp"
            app:tabSelectedTextColor="@color/colorRedNew"
            app:tabTextColor="@color/colorText">

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tabItem1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/tab1" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tabItem2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/tab2" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tabItem3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/tab3" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tabItem4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/tab4" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tabItem5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/tab5" />
        </com.google.android.material.tabs.TabLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:weightSum="5"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tbSort"
            app:layout_constraintVertical_bias="0.0">

            <!--All Count-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvAllCount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="11"
                android:textColor="@color/colorLightBlack"
                android:textSize="8sp"
                tools:text="11" />

            <!--Batsman Count-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvBatsmanCount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/colorLightBlack"
                android:textSize="8sp"
                tools:text="4" />

            <!--All Count-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvKeeperCount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/colorLightBlack"
                android:textSize="8sp"
                tools:text="1" />

            <!--All Count-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvAllRounderCount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/colorLightBlack"
                android:textSize="8sp"
                tools:text="3" />

            <!--All Count-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvBowlerCount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/colorLightBlack"
                android:textSize="8sp"
                tools:text="3" />

        </LinearLayout>

        <!--Player-->
        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:drawableEnd="@drawable/ic_search_red_new"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:text="@string/text_player"
            android:textColor="@color/colorRedText"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toStartOf="@+id/tvPriceSort"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
            app:layout_constraintVertical_bias="0.0" />

        <!--Price-->
        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
            android:id="@+id/tvPriceSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="2"
            android:drawableEnd="@drawable/ic_swap_black"
            android:gravity="center"
            android:text="@string/text_price"
            android:textColor="@color/colorRedText"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
            app:layout_constraintVertical_bias="0.0" />


        <!--Action-->
        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
            android:id="@+id/tvPointsSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="2"
            android:drawableEnd="@drawable/ic_swap_black"
            android:gravity="center"
            android:text="@string/text_points"
            android:textColor="@color/colorRedText"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.44"
            app:layout_constraintStart_toEndOf="@+id/tvPriceSort"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
            app:layout_constraintVertical_bias="0.0" />

        <com.yorker.fanzania.widgets.ExpandableLayout
            android:id="@+id/explPlayerSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:el_duration="300"
            app:el_expanded="false"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPlayerName"
            app:layout_constraintVertical_bias="0.0">

            <LinearLayout
                android:id="@+id/rlSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="5dp"
                    android:backgroundTint="@color/colorGrey"
                    android:hint="@string/text_searchby"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/colorText"
                    android:textColorHint="@color/colorBorder"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:backgroundTint="@color/colorDarkGreyNew" />

            </LinearLayout>

        </com.yorker.fanzania.widgets.ExpandableLayout>

        <include
            android:id="@+id/inRecyclerview"
            layout="@layout/commonrecycleview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/rlSaveTeam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explPlayerSearch" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>