<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:gravity="center">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="55dp"
            android:background="@drawable/round_background_dialog"
            android:padding="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            >

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:text="@string/text_enterteamname"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="15dp"
                android:id="@+id/txtTitle"
                android:textColor="@color/colorBlack"
                />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_centerInParent="true"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:id="@+id/edtContent"
                android:maxLength="10"
                android:textColor="@color/colorText"
                android:gravity="center"
                android:textSize="14sp"
                android:background="@drawable/round_background_dark"
                />
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratLight
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/edtContent"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:id="@+id/txtError"
                android:textColor="@color/colorBlack"
                />

            <com.yorker.fanzania.customviews.CustomButton
                android:layout_width="90dp"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/round_corner_dark_ripple"
                android:text="@string/text_continue"
                android:gravity="center"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:textColor="@color/colorWhite"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:id="@+id/btnYes"
                android:layout_marginBottom="5dp"
                />

            <com.yorker.fanzania.customviews.CustomButton
                android:layout_width="90dp"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/round_corner_red_ripple"
                android:text="@string/text_cancel"
                android:gravity="center"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:textColor="@color/colorWhite"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:id="@+id/btnNo"
                android:layout_marginBottom="5dp"
                />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/pBar"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/colorLight1"
            android:padding="10dp"
            android:layout_marginTop="55dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />
        </RelativeLayout>

    </RelativeLayout>
</layout>