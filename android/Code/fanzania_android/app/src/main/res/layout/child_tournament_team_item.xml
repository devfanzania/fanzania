<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >

        <RelativeLayout
            android:id="@+id/rlMain"
            android:layout_width="110dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_height="wrap_content"
            >

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvLeft"
                android:textColor="@color/colorWhite"
                android:layout_marginStart="5dp"
                android:textSize="10sp"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratLight
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_vs"
                android:id="@+id/tvVS"
                android:textColor="@color/colorWhite"
                android:textSize="12sp"
                android:layout_centerHorizontal="true"
                tools:ignore="RelativeOverlap" />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvRight"
                android:textColor="@color/colorWhite"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="5dp"
                android:textSize="10sp"
                />

            <ImageView
                android:id="@+id/imgTick"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_check_black"
                android:layout_marginTop="2dp"
                android:visibility="gone"
                android:layout_marginEnd="5dp"
                android:layout_below="@+id/tvVS"
                android:layout_toStartOf="@+id/tvStatus"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvStatus"
                android:textAllCaps="true"
                android:text=""
                android:layout_marginTop="2dp"
                android:layout_below="@+id/tvVS"
                android:layout_centerInParent="true"
                android:textColor="@color/colorWhite"
                android:textSize="10sp"
                />
        </RelativeLayout>

    </LinearLayout>
</layout>