<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".views.screens.tournament.manageleague.ManageLeagueActivity">

        <include
            android:id="@+id/inToolbar"
            layout="@layout/commontoolbar"/>

        <!--League Name-->
        <LinearLayout

            android:id="@+id/llLeagueName"
            android:orientation="vertical"
            android:layout_marginTop="100dp"
            android:paddingRight="40dp"
            android:paddingLeft="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtLeagueName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:paddingStart="10dp"
                android:textColor="@color/colorText"
                android:text="@string/text_leaguename"/>

            <EditText
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edittext_height"
                android:id="@+id/edtLeagueName"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/round_corner"
                />
            <TextView
                android:visibility="gone"
                android:id="@+id/txtErrorLeagueName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:paddingStart="10dp"
                android:textColor="@color/colorRed"
                />

        </LinearLayout>



        <com.yorker.fanzania.customviews.CustomButton
            android:layout_width="@dimen/button_width"
            android:layout_gravity="center"
            android:id="@+id/btnSignUp"
            android:layout_below="@+id/llLeagueName"
            android:background="@drawable/round_corner_gradient"
            android:layout_height="@dimen/button_height"
            android:textColor="@color/colorWhite"
            android:text="@string/text_save"
            android:layout_marginTop="50dp"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:textSize="16sp"
            />

    </RelativeLayout>
</layout>