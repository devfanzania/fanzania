<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.yorker.fanzania.widgets.SwipeRevealLayout
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dragEdge="right"
        app:mode="same_level">

        <LinearLayout
            android:id="@+id/llAction"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:orientation="horizontal">

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvAdd"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@color/colorGreen"
                android:gravity="center"
                android:text="@string/text_add"
                android:visibility="gone"
                android:textColor="@color/colorWhite"
                android:textSize="12sp" />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvView"
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@color/colorOrangeNew"
                android:gravity="center"
                android:text="@string/text_viewteam"
                android:textColor="@color/colorWhite"
                android:textSize="12sp" />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvDelete"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@color/colorRedNew"
                android:gravity="center"
                android:text="@string/text_rejected"
                android:visibility="gone"
                android:textColor="@color/colorWhite"
                android:textSize="12sp" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/rrHeader"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1.7"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgRank"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center" />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:id="@+id/tvRank"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textColor="@color/colorText"
                    android:textSize="12sp" />

            </LinearLayout>

<!--            &lt;!&ndash;Supported team &ndash;&gt;-->
<!--            <RelativeLayout-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_height="match_parent"-->
<!--                android:layout_weight="1.8">-->

<!--                <ImageView-->
<!--                    android:id="@+id/imgTeam"-->
<!--                    android:layout_width="35dp"-->
<!--                    android:layout_height="35dp"-->
<!--                    android:layout_centerInParent="true"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:layout_marginTop="2dp"-->
<!--                    android:src="@drawable/ic_infinity"-->
<!--                    android:visibility="visible" />-->

<!--            </RelativeLayout>-->

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_weight="2.7"
                >

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:id="@+id/tvTeamName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="5dp"
                    android:paddingStart="5dp"
                    android:layout_toEndOf="@+id/imgTeam"
                    android:singleLine="true"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgTeam"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:src="@drawable/ic_infinity"
                    android:visibility="visible" />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:id="@+id/tvOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvTeamName"
                    android:layout_toStartOf="@+id/img"
                    android:layout_toEndOf="@+id/img1"
                    android:layout_marginVertical="7.5dp"
                    android:paddingStart="5dp"
                    android:singleLine="true"
                    android:gravity="start"
                    android:textAlignment="textStart"
                    android:textColor="@color/colorLightBlack"
                    android:textSize="10sp"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:layout_below="@+id/imgTeam"
                    android:id="@+id/img"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_alignParentEnd="true"
                    />

                <ImageView
                    android:layout_marginVertical="7.5dp"
                    android:layout_alignParentStart="true"
                    android:id="@+id/img1"
                    android:layout_width="32dp"
                    android:layout_height="25dp"
                    android:layout_below="@+id/tvTeamName"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    />

            </RelativeLayout>

            <!--Transfer -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.8">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:id="@+id/tvTransferPending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:singleLine="true"
                    android:paddingEnd="5dp"
                    android:textColor="@color/colorText"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/imgInfinity"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_infinity"
                    android:visibility="gone" />

            </RelativeLayout>

            <!--Points-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:id="@+id/tvPoints"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:singleLine="true"
                android:textColor="@color/colorText"
                android:textSize="12sp" />

            <!--Last MAtch-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/tvLastMatch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:singleLine="true"
                android:text="-"
                android:textColor="@color/colorBlack"
                android:textSize="10sp" />

        </LinearLayout>

    </com.yorker.fanzania.widgets.SwipeRevealLayout>
</layout>