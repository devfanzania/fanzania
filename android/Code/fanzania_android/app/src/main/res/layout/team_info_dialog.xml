<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:background="@drawable/round_background_dialog"
            android:padding="10dp"
            android:layout_centerInParent="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            >

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:text="@string/text_teamcreateinfo"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:id="@+id/txtTitle"
                android:textColor="@color/colorBlack"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="match_parent"
                android:id="@+id/tvDetails"
                android:layout_below="@id/txtTitle"
                android:layout_marginTop="10dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvPowerplay"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:text="Power Plays ( One time Use)"
                android:layout_below="@+id/tvDetails"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvPowerplayDetails"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/tvPowerplay"
                android:layout_marginBottom="10dp"
                />

            <com.yorker.fanzania.customviews.CustomButton
                android:layout_width="90dp"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/round_corner_dark_ripple"
                android:text="@string/text_ok"
                android:gravity="center"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/tvPowerplayDetails"
                android:textColor="@color/colorWhite"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:id="@+id/btnYes"
                android:layout_marginBottom="5dp"
                />

        </RelativeLayout>

    </RelativeLayout>
</layout>