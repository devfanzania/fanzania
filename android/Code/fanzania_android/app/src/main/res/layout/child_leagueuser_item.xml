<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:id="@+id/llLeagueHeaders"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <!--Rank-->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1.7"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgRank"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center" />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:id="@+id/tvRank"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textColor="@color/colorDark"
                    android:textSize="12sp" />

            </LinearLayout>

            <!--Team Name | Power Play-->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="3.1">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:paddingStart="5dp"
                    android:id="@+id/tvTeamName"
                    android:singleLine="true"
                    android:layout_alignParentTop="true"
                    android:textColor="@color/colorDark"
                    android:textSize="12sp" />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:gravity="center_vertical"
                    android:layout_below="@+id/tvTeamName"
                    android:paddingStart="5dp"
                    android:id="@+id/tvTeamOwnerName"
                    android:textColor="@color/colorLightBlack"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:id="@+id/imgPowerPlay"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>

            <!--TRansfer-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:gravity="center"
                android:id="@+id/tvTransfer"
                android:textColor="@color/colorDark"
                android:textSize="12sp" />

            <!--Total-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:gravity="center"
                android:id="@+id/tvTotalPoints"
                android:textColor="@color/colorDark"
                android:textSize="12sp" />

            <!--Points-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:gravity="center"
                android:text=""
                android:id="@+id/tvPoints"
                android:textColor="@color/colorDark"
                android:drawableEnd="@drawable/ic_right_arrow_new"
                android:paddingEnd="3dp"
                android:textSize="12sp"
                tools:ignore="RtlSymmetry" />

        </LinearLayout>

    </RelativeLayout>
</layout>