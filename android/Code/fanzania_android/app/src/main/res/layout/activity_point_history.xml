<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".views.screens.tournament.pointhistory.PointHistoryActivity">

        <include
            android:id="@+id/inToolbar"
            layout="@layout/commontoolbar"/>

        <RelativeLayout
            android:layout_below="@+id/inToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/llHeader"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/text_mytournament"
                    android:textColor="@color/colorWhite"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:background="@color/colorPrimary"
                    />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/text_myteam"
                    android:textColor="@color/colorWhite"
                    android:textSize="10sp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:background="@color/colorPrimary"
                    />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/text_mypoints"
                    android:textColor="@color/colorWhite"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:background="@color/colorPrimary"
                    />

            </LinearLayout>

            <include
                android:id="@+id/inRVList"
                layout="@layout/commonrecycleview"
                android:layout_below="@+id/llHeader"
                android:layout_above="@+id/llFooter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


            <LinearLayout
                android:id="@+id/llFooter"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="@string/text_totalpoints"
                    android:textColor="@color/colorWhite"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:background="@color/colorRed"
                    />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:text="5100000009"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/colorWhite"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:layout_marginStart="3dp"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:background="@color/colorRed"
                    />


            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>
</layout>