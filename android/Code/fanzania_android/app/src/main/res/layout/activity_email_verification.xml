<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/otplayout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/log_bg"
        >

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/inToolbar"
            layout="@layout/commontoolbar"/>

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/pbVerification"
            android:layout_centerInParent="true"/>

        <LinearLayout
            android:id="@+id/llMain"
            android:visibility="visible"
            android:layout_below="@+id/inToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/otpheadertext"
                android:textColor="@color/colorWhite"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:textSize="18sp"
                android:text="@string/text_enterverificationcode"
                />

            <com.yorker.fanzania.widgets.PinEntryEditText
                android:background="@null"
                android:id="@+id/txt_pin_entry2"
                android:layout_width="220dp"
                android:layout_height="40dp"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="50dp"
                android:layout_gravity="center"
                android:digits="1234567890"
                android:cursorVisible="true"
                android:layout_marginTop="50dp"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@android:color/transparent"
                android:textIsSelectable="false"
                android:textSize="0px"
                android:visibility="visible"
                app:pinBackgroundDrawable="@drawable/bg_pin_round"
                app:pinBackgroundIsSquare="true"
                app:pinTextBottomPadding="4dp"
                app:pinCharacterSpacing="1dp"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/text_resendtext"
                android:textColor="@color/colorWhite"
                />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                >

                <com.yorker.fanzania.customviews.CustomButton
                    android:layout_width="match_parent"
                    android:id="@+id/btnResend"
                    android:background="@drawable/round_corner_red"
                    android:layout_height="@dimen/button_height_new"
                    android:textColor="@color/colorWhite"
                    android:text="@string/text_resend"
                    app:fontName="Montserrat_Medium"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    />

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    android:id="@+id/pbResend"/>

            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>
</layout>