                    <LinearLayout
                        android:id="@+id/llNewPassword"
                        android:orientation="vertical"
                        android:paddingRight="30dp"
                        android:paddingLeft="30dp"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <EditText
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edittext_height"
                            android:id="@+id/edtNPass"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="10dp"
                            android:textCursorDrawable="@color/colorWhite"
                            android:paddingStart="15dp"
                            android:hint="@string/text_newpassword"
                            android:textColor="@color/colorWhite"
                            android:textColorHint="@color/colorWhite"
                            android:textSize="12sp"
                            android:paddingEnd="15dp"
                            android:background="@drawable/round_corner_white_border"
                            />
                        <TextView
                            android:id="@+id/txtErrorNPass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="2dp"
                            android:textSize="10sp"
                            android:paddingStart="10dp"
                            android:textColor="@color/colorRed"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llConfirmPassword"
                        android:orientation="vertical"
                        android:paddingRight="30dp"
                        android:paddingLeft="30dp"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edittext_height"
                            android:id="@+id/edtCnfPass"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textSize="12sp"
                            android:hint="@string/text_confirmpassword"
                            android:textColorHint="@color/colorWhite"
                            android:paddingStart="15dp"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="10dp"
                            android:textColor="@color/colorWhite"
                            android:paddingEnd="15dp"
                            android:background="@drawable/round_corner_white_border"
                            />
                        <TextView
                            android:id="@+id/txtErrorCnfPass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="2dp"
                            android:textSize="10sp"
                            android:paddingStart="10dp"
                            android:textColor="@color/colorRed"
                            />

                    </LinearLayout>


                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="30dp"
                        >

                        <com.yorker.fanzania.customviews.CustomButton
                            android:layout_width="match_parent"
                            android:id="@+id/btnSave"
                            android:background="@drawable/round_corner_red"
                            android:layout_height="@dimen/button_height_new"
                            android:textColor="@color/colorWhite"
                            android:text="@string/text_save"
                            app:fontName="Montserrat_Medium"
                            android:textAllCaps="true"
                            android:textSize="16sp"
                            />

                        <ProgressBar
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:visibility="gone"
                            android:id="@+id/pbSave"/>

                    </RelativeLayout>

                </LinearLayout>

