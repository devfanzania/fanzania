<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:padding="5dp"
        >

        <LinearLayout
            android:id="@+id/llSub"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:weightSum="3"
            tools:ignore="UselessParent">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:id="@+id/tvLeftTeamName"
                    android:background="@drawable/left_side_round"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:layout_marginEnd="15dp"
                    android:layout_centerVertical="true"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"/>

                <ImageView
                    android:id="@+id/imgLeftTeamLogo"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/blank_jersey"
                    />

            </RelativeLayout>

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:text="V"
                android:textSize="16sp"
                android:textColor="@color/colorDark"
                android:gravity="center"/>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@drawable/right_side_round"
                    android:id="@+id/tvRightTeamName"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:layout_marginStart="15dp"
                    android:layout_centerVertical="true"
                    android:textColor="@color/colorWhite"
                    android:gravity="center"/>

                <ImageView
                    android:id="@+id/imgRightTeamLogo"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:src="@drawable/blank_jersey"
                    />


            </RelativeLayout>


        </LinearLayout>

    </RelativeLayout>

</layout>