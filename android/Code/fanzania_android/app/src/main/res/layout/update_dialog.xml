<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:gravity="center">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/round_background_dialog"
            android:padding="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            >

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:text="Title"
                android:textSize="16sp"
                android:id="@+id/txtTitle"
                android:textColor="@color/colorBlack"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/txtTitle"
                android:id="@+id/txtContent"
                android:textColor="@color/colorText"
                android:gravity="center"
                android:textSize="14sp"

                />

            <com.yorker.fanzania.customviews.CustomButton
                android:layout_width="90dp"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/round_dark"
                android:text="@string/text_update"
                android:gravity="center"
                android:textSize="14sp"
                android:textAllCaps="false"
               android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:textColor="@color/colorWhite"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:id="@+id/btnYes"
                android:layout_marginBottom="5dp"
                />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/pBar"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/colorLight1"
            android:padding="10dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />
        </RelativeLayout>

    </RelativeLayout>
</layout>