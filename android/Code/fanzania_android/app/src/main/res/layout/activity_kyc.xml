<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <RelativeLayout
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <include
            android:id="@+id/inToolbar"
            layout="@layout/commontoolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tbSort"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/inToolbar"
            app:tabBackground="@color/colorGreyNew"
            app:tabIndicatorColor="@color/colorPink"
            app:tabMode="fixed"
            app:tabPaddingEnd="10dp"
            app:tabIndicatorHeight="4dp"
            app:tabPaddingStart="10dp"
            app:tabSelectedTextColor="@color/colorPink"
            app:tabTextColor="@color/colorText">

            <com.google.android.material.tabs.TabItem
                android:text="PAN"
                android:id="@+id/tabItem1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.tabs.TabItem
                android:text="Contact Details"
                android:id="@+id/tabItem2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tabItem3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BANK" />

<!--            <android.support.design.widget.TabItem-->
<!--                android:id="@+id/tabItem4"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout="@layout/tab4" />-->

<!--            <android.support.design.widget.TabItem-->
<!--                android:id="@+id/tabItem5"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout="@layout/tab5" />-->
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_below="@id/tbSort"
            android:id="@+id/simpleFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </RelativeLayout>
</layout>