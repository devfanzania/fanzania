<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:id="@+id/clTab2"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:weightSum="10">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.3">

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/txtPlayer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="5dp"
                android:textColor="@color/colorText"
                android:textSize="12sp"
                tools:text="Player Name" />
            <ImageView
                android:id="@+id/imgOverseas"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_overseas"
                android:layout_gravity="center"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/imgCVC"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
            android:id="@+id/txtBating"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:gravity="center"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            tools:text="123" />

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
            android:id="@+id/txtBowling"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:gravity="center"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            tools:text="123" />

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
            android:id="@+id/txtFielding"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:gravity="center"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            tools:text="123" />

        <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
            android:id="@+id/txtTotal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.9"
            android:gravity="center"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            tools:text="123" />
    </LinearLayout>

