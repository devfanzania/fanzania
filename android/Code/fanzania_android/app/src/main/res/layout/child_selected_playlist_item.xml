<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp">

        <RelativeLayout
            android:id="@+id/rrHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dimen_5dp"
            android:paddingEnd="@dimen/dimen_5dp"
            android:background="@drawable/round_corner_selected_player_list">

            <ImageView
                android:layout_width="15dp"
                android:id="@+id/imgLogo"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_height="15dp"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:id="@+id/tvPlayerName"
                android:layout_height="25dp"
                android:textColor="@color/colorText"
                android:textSize="12sp"
                android:paddingEnd="5dp"
                android:paddingStart="5dp"
                android:singleLine="true"
                android:layout_toEndOf="@+id/imgLogo"
                android:gravity="center_vertical"
                />

            <ImageView
                android:id="@+id/imgCVC"
                android:layout_toEndOf="@+id/tvPlayerName"
                android:layout_width="15dp"
                android:layout_centerVertical="true"
                android:layout_height="15dp" />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:layout_width="wrap_content"
                android:id="@+id/tvTeamName"
                android:layout_height="25dp"
                android:textColor="@color/colorText"
                android:textSize="12sp"
                android:singleLine="true"
                android:paddingEnd="5dp"
                android:layout_toStartOf="@+id/imgRemove"
                android:gravity="center_vertical"
                />

            <ImageView
                android:layout_width="15dp"
                android:id="@+id/imgRemove"
                android:layout_height="15dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_bleach_sign"
                />

        </RelativeLayout>


    </RelativeLayout>
</layout>