<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/log_bg">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:fitsSystemWindows="true"
            android:background="@android:color/transparent"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            />

        <LinearLayout
            android:layout_below="@+id/toolbar"
            android:layout_centerVertical="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLogo1"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/app_fanzania" />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                android:id="@+id/montserratMedium1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:layout_marginEnd="8dp"
                android:text="@string/text_fanzanialogin"
                android:textColor="@color/colorWhite"
                android:textSize="18sp" />

            <!--Email-->

            <LinearLayout
                android:id="@+id/llEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:orientation="vertical"
                android:paddingLeft="30dp"
                android:paddingRight="30dp">

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_new"
                    android:layout_marginTop="5dip"
                    android:background="@drawable/round_corner_white_border"
                    android:inputType="textEmailAddress"
                    android:hint="@string/text_emailaddress"
                    android:focusable="true"
                    android:cursorVisible="true"
                    android:drawableStart="@drawable/ic_mail"

                    android:textColorHint="@color/colorWhite"
                    android:drawablePadding="10dp"
                    android:paddingStart="15dip"
                    android:paddingEnd="15dip"
                    android:textColor="@color/colorWhite"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtErrorEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="2dip"
                    android:paddingStart="10dip"
                    android:textColor="@color/colorRedNew"
                    android:textSize="10sp"
                    tools:ignore="RtlSymmetry" />

            </LinearLayout>

            <!--Password-->
            <LinearLayout
                android:id="@+id/llPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingLeft="30dp"
                android:paddingRight="30dp">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_new"
                    android:layout_marginTop="5dip"
                    android:background="@drawable/round_corner_white_border"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:hint="@string/text_password"
                    android:textColorHint="@color/colorWhite"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="10dp"
                    android:paddingStart="15dip"
                    android:textColor="@color/colorWhite"
                    android:paddingEnd="15dip"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtErrorPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="2dip"
                    android:paddingStart="10dip"
                    android:textColor="@color/colorRedNew"
                    android:textSize="10sp"
                    tools:ignore="RtlSymmetry,SmallSp" />
            </LinearLayout>

            <!--Forgot Password-->
            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:id="@+id/txtForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginEnd="5dp"
                android:paddingStart="20dip"
                android:paddingTop="10dip"
                android:paddingEnd="40dip"
                android:paddingBottom="10dip"
                android:text="@string/text_forgotpass"
                android:textColor="@color/colorAppIcon"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                >

                <com.yorker.fanzania.customviews.CustomButton
                    android:layout_width="match_parent"
                    android:id="@+id/btnSignIn"
                    android:background="@drawable/round_corner_red"
                    android:layout_height="@dimen/button_height_new"
                    android:textColor="@color/colorWhite"
                    android:text="@string/text_signin"
                    app:fontName="Montserrat_Medium"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    />

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    android:id="@+id/pbSignUp"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_or"
                    android:id="@+id/txtOr"
                    android:textColor="@color/colorWhite"
                    android:layout_centerInParent="true"
                    />

                <View
                    android:layout_toStartOf="@+id/txtOr"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/colorWhite"
                    android:layout_centerVertical="true"
                    />

                <View
                    android:layout_toEndOf="@+id/txtOr"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="10dp"
                    android:background="@color/colorWhite"
                    android:layout_centerVertical="true"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                >

                <LinearLayout

                    android:layout_width="140dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="10dp"
                    android:layout_alignParentStart="true"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/round_corner_white_fb"
                    >

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_fb_logo"
                        />

                    <com.yorker.fanzania.customviews.CustomButton
                        android:id="@+id/btnFacebook"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_fb"
                        android:layout_marginStart="5dp"
                        android:textAllCaps="false"
                        android:textColor="@color/colorWhite"
                        android:background="@android:color/transparent"
                        app:fontName="Montserrat_Regular"
                        android:textSize="16sp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"

                    android:gravity="center"
                    android:background="@drawable/round_corner_white_google"
                    >

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_google_plus"
                        />

                    <com.yorker.fanzania.customviews.CustomButton
                        android:id="@+id/btnGoogle"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/text_google"
                        android:textAllCaps="false"
                        android:textColor="@color/colorWhite"
                        app:fontName="Montserrat_Regular"
                        android:background="@android:color/transparent"
                        android:textSize="16sp"
                        />
                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnGotoSignUp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="@string/text_donthaveaccount"
                    android:textAllCaps="false"
                    android:textColor="@color/colorWhite"
                    android:textSize="14sp"
                    />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="@string/text_clickheretosignup"
                    android:textAllCaps="false"
                    android:layout_marginStart="3dp"
                    android:textColor="@color/colorRedNew"
                    android:textSize="14sp"
                    />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="@color/colorWhite"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnSupport"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="@string/text_forsupport"
                    android:textAllCaps="false"
                    android:textColor="@color/colorWhite"
                    android:textSize="14sp"
                    />

                <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratMedium
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="@string/text_contactus"
                    android:textAllCaps="false"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/colorRedNew"
                    android:textSize="14sp"
                    />

            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>


</layout>