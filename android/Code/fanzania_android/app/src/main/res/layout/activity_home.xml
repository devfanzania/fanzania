<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/log_bg">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_alignParentTop="true"
            android:theme="@style/ThemeOverlay.AppCompat.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/colorBlack"
                android:fitsSystemWindows="true"
                app:popupTheme="@style/AppTheme.PopupOverlay">

                <LinearLayout
                    android:id="@+id/llText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_logo_icon"
                        />
                    <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                        android:layout_width="wrap_content"
                        android:id="@+id/txtHeader"
                        android:layout_height="40dp"
                        tools:text="hvgvg"
                        android:paddingStart="10dp"
                        android:textColor="@color/colorWhite"
                        android:gravity="center_vertical"/>
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rgSwitch"
                    android:visibility="visible"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                   >

                    <RadioButton
                        android:id="@+id/rbMatchContests"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:button="@android:color/transparent"
                        android:textSize="12sp"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/radiobuttonselector"
                        android:text="@string/text_matchcontests"
                        android:textColor="@color/colorWhite" />

                    <RadioButton
                        android:id="@+id/rbTaurnament"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:button="@android:color/transparent"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/radiobuttonselector"
                        android:layout_marginStart="10dp"
                        android:text="@string/text_tournament"
                        android:textColor="@color/colorWhite" />
                </RadioGroup>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/navigation"
            android:layout_below="@+id/appBar"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/colorWhite" />

            <RelativeLayout
                android:id="@+id/rrContentFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </RelativeLayout>
        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navigation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_alignParentBottom="true"
            android:background="@color/colorBlack"
            android:theme="@style/BottomNavigationDrawerStyle"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/navigation" />
    </RelativeLayout>
</layout>