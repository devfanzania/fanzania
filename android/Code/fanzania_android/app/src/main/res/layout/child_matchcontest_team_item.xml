<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp"
        >

        <RelativeLayout
            android:id="@+id/rlMain"
            android:layout_width="135dp"
            android:layout_height="40dp"
            >

            <ImageView
                android:layout_alignParentStart="true"
                android:id="@+id/imgBattingFirst"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_bat"
                android:visibility="gone"
                android:layout_marginEnd="2dp"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratLight
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvTeamName"
                android:textColor="@color/colorWhite"
                android:textSize="12sp"
                android:layout_toEndOf="@+id/imgBattingFirst"
                android:layout_marginStart="2dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                tools:ignore="RelativeOverlap"
                />

            <ImageView
                android:id="@+id/imgBattingSecond"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_toEndOf="@+id/tvTeamName"
                android:src="@drawable/ic_bat"
                android:visibility="gone"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp"
                />

            <ImageView
                android:layout_alignParentEnd="true"
                android:id="@+id/imgWeather"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/cloudy"
                android:visibility="visible"
                android:layout_marginEnd="2dp"
                />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_centerInParent="true"
                android:background="@color/colorWhite"
                />

            <ImageView
                android:id="@+id/imgTick"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_check_black"
                android:layout_marginTop="5dp"
                android:visibility="visible"
                android:layout_marginEnd="5dp"
                android:layout_below="@+id/tvTeamName"
                android:layout_toStartOf="@+id/tvStatus"
                />

            <com.yorker.fanzania.customviews.customfonts.montserrat.MontserratRegular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvStatus"
                android:textAllCaps="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/tvTeamName"
                android:textColor="@color/colorWhite"
                android:textSize="10sp"
                />

        </RelativeLayout>
    </LinearLayout>

